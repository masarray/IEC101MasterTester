<Window x:Class="IEC101MasterTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IEC101MasterTester"
        Height="860"
        Width="1560"
        MinWidth="1320"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" Icon="/iec60870-icon.jpg">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PanelDataGridStyle" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserReorderColumns" Value="True"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>

                <!-- visual tuning -->
                <Setter Property="RowHeight" Value="32"/>
                <Setter Property="MinRowHeight" Value="30"/>
                <Setter Property="ColumnHeaderHeight" Value="36"/>
                <Setter Property="Background" Value="#0B1220"/>
                <Setter Property="Foreground" Value="#E5EDF7"/>
                <Setter Property="BorderBrush" Value="#243244"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#182434"/>
                <Setter Property="VerticalGridLinesBrush" Value="#182434"/>
                <Setter Property="RowBackground" Value="#0E1625"/>
                <Setter Property="AlternatingRowBackground" Value="#111C2D"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>

                <Style.Resources>

                    <!-- Column Header -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#132033"/>
                        <Setter Property="Foreground" Value="#D7E3F1"/>
                        <Setter Property="BorderBrush" Value="#223044"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="10,0,10,0"/>
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <!-- Cell -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="#E5EDF7"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#182434"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="10,0,10,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#1C3357"/>
                                <Setter Property="BorderBrush" Value="#29456F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <!-- Row -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#0E1625"/>
                        <Setter Property="Foreground" Value="#E5EDF7"/>
                        <Setter Property="BorderBrush" Value="#182434"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                        <SelectiveScrollingGrid>
                                            <SelectiveScrollingGrid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </SelectiveScrollingGrid.ColumnDefinitions>
                                            <SelectiveScrollingGrid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </SelectiveScrollingGrid.RowDefinitions>

                                            <DataGridCellsPresenter Grid.Column="1"/>
                                            <DataGridDetailsPresenter Grid.Column="1"
                                                          Grid.Row="1"
                                                          Visibility="{TemplateBinding DetailsVisibility}"/>
                                        </SelectiveScrollingGrid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#132033"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1C3357"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <!-- RowHeader hidden safe -->
                    <Style TargetType="DataGridRowHeader">
                        <Setter Property="Width" Value="0"/>
                    </Style>

                    <!-- ScrollBar optional dark blending -->
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="#0B1220"/>
                        <Setter Property="Width" Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Border Background="#0E1625"
                                            CornerRadius="4"
                                            SnapsToDevicePixels="True">
                                        <Track x:Name="PART_Track"
                                               IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                                              Focusable="False"
                                                              Opacity="0"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{DynamicResource DarkScrollBarThumbStyle}"/>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                                              Focusable="False"
                                                              Opacity="0"/>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="10"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Border Background="#0E1625"
                                                    CornerRadius="4"
                                                    SnapsToDevicePixels="True">
                                                <Track x:Name="PART_Track">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                                      Focusable="False"
                                                                      Opacity="0"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Style="{DynamicResource DarkScrollBarThumbStyle}"/>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                                                      Focusable="False"
                                                                      Opacity="0"/>
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Style.Resources>
            </Style>
            <Style x:Key="DarkScrollBarThumbStyle" TargetType="Thumb">
                <Setter Property="Background" Value="#3A4C63"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Margin="3,2,3,2"
                        CornerRadius="3"
                        Background="{TemplateBinding Background}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#516883"/>
                    </Trigger>
                    <Trigger Property="IsDragging" Value="True">
                        <Setter Property="Background" Value="#6B87A6"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DarkVerticalScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Background" Value="#0B1220"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="#0E1625"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track"
                           IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                          Focusable="False"
                                          Opacity="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource DarkScrollBarThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                          Focusable="False"
                                          Opacity="0"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkHorizontalScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Height" Value="10"/>
                <Setter Property="Background" Value="#0B1220"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="#0E1625"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                          Focusable="False"
                                          Opacity="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource DarkScrollBarThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                          Focusable="False"
                                          Opacity="0"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource TactileSecondaryButtonStyle}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="14,0"/>
            </Style>
            <Style x:Key="HeaderToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource TactileSecondaryButtonStyle}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                <Setter Property="Background" Value="{StaticResource HeaderAltBrush}"/>
                <Setter Property="BorderBrush" Value="#314255"/>
            </Style>
            <Style x:Key="ToolbarCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource TactileSecondaryButtonStyle}">
                <Setter Property="Width" Value="86"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Background" Value="{StaticResource HeaderAltBrush}"/>
                <Setter Property="BorderBrush" Value="#314255"/>
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style x:Key="ToolbarCommandPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TactilePrimaryButtonStyle}">
                <Setter Property="Width" Value="86"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Margin" Value="8,6,12,6"/>
                <Setter Property="Background" Value="#334155"/>
            </Style>

            <Style x:Key="ToolbarIconTextStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            </Style>
            <Style x:Key="RoundIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource HeaderAltBrush}"/>
                <Setter Property="BorderBrush" Value="#314255"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Circle"
                             Fill="{TemplateBinding Background}"
                             Stroke="{TemplateBinding BorderBrush}"
                             StrokeThickness="{TemplateBinding BorderThickness}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="1"
                                              BlurRadius="4"
                                              Opacity="0.25"/>
                                    </Ellipse.Effect>
                                </Ellipse>

                                <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Circle"
                                Property="Fill"
                                Value="#1B2A3D"/>
                                    <Setter TargetName="Circle"
                                Property="Stroke"
                                Value="{StaticResource AccentBrush}"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Circle"
                                Property="Fill"
                                Value="#101826"/>
                                    <Setter TargetName="Circle"
                                Property="Stroke"
                                Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Circle"
                                Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Circle"
                                Property="Effect"
                                Value="{x:Null}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Circle"
                                Property="Opacity"
                                Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DarkExpanderHeaderToggleStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="#E2E8F0"/>
                <Setter Property="Background" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <DockPanel LastChildFill="True">
                                    <Path x:Name="Arrow"
                                          Width="10"
                                          Height="10"
                                          Margin="6,0,8,0"
                                          VerticalAlignment="Center"
                                          Fill="{TemplateBinding Foreground}"
                                          Data="M 0 0 L 8 0 L 4 5 Z"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#1B2A3D"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#101826"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" CenterX="4" CenterY="2.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DarkExpanderStyle" TargetType="Expander">
                <Setter Property="Foreground" Value="#E2E8F0"/>
                <Setter Property="Background" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Top"
                                                  Style="{StaticResource DarkExpanderHeaderToggleStyle}"
                                                  Content="{TemplateBinding Header}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <ContentPresenter x:Name="ExpandSite"
                                                      Margin="0"
                                                      Visibility="Collapsed"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PanelSectionBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#0B1220"/>
                <Setter Property="BorderBrush" Value="#243244"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
            <Style x:Key="PanelHeaderBarStyle" TargetType="Border">
                <Setter Property="Background" Value="#101A2A"/>
                <Setter Property="BorderBrush" Value="#243244"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="12,8"/>
            </Style>
            <Style x:Key="PanelHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F1F5F9"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SidePaneBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TactileSecondaryButtonStyle}">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#CBD5E1"/>
                <Setter Property="Background" Value="#0F172A"/>
                <Setter Property="BorderBrush" Value="#334155"/>
            </Style>
            <Style x:Key="VerticalRailToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Foreground" Value="#CBD5E1"/>
                <Setter Property="Background" Value="#0F172A"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="RailBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="22"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top arrow -->
                                    <Path x:Name="TopArrow"
                              Grid.Row="0"
                              Width="8"
                              Height="8"
                              Margin="0,6,0,4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{TemplateBinding Foreground}"
                              Data="M 0 0 L 8 0 L 4 5 Z"/>

                                    <!-- Vertical title -->
                                    <Grid Grid.Row="1" ClipToBounds="False">
                                        <TextBlock x:Name="RailText"
                                       Text="{TemplateBinding Content}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="-90"/>
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Bottom arrow -->
                                    <Path x:Name="BottomArrow"
                              Grid.Row="2"
                              Width="8"
                              Height="8"
                              Margin="0,4,0,6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{TemplateBinding Foreground}"
                              Data="M 0 5 L 8 5 L 4 0 Z"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>

                                <!-- Hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RailBorder" Property="Background" Value="#17202B"/>
                                    <Setter TargetName="RailBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>

                                <!-- Pressed -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="RailBorder" Property="Background" Value="#101826"/>
                                    <Setter TargetName="RailBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>

                                <!-- Checked -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RailBorder" Property="Background" Value="#0F172A"/>
                                    <Setter TargetName="RailBorder" Property="BorderBrush" Value="#334155"/>
                                    <Setter Property="Foreground" Value="#CBD5E1"/>

                                    <Setter TargetName="TopArrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" CenterX="4" CenterY="2.5"/>
                                        </Setter.Value>
                                    </Setter>

                                    <Setter TargetName="BottomArrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" CenterX="4" CenterY="2.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>

                                <!-- Disabled -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="RailBorder" Property="Opacity" Value="0.45"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="VerticalRailToggleButtonRightStyle"
       TargetType="ToggleButton"
       BasedOn="{StaticResource VerticalRailToggleButtonStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="RailBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="22"/>
                                    </Grid.RowDefinitions>

                                    <Path x:Name="TopArrow"
                              Grid.Row="0"
                              Width="8"
                              Height="8"
                              Margin="0,6,0,4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{TemplateBinding Foreground}"
                              Data="M 0 0 L 8 0 L 4 5 Z"/>

                                    <Grid Grid.Row="1" ClipToBounds="False">
                                        <TextBlock x:Name="RailText"
                                       Text="{TemplateBinding Content}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90"/>
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </Grid>

                                    <Path x:Name="BottomArrow"
                              Grid.Row="2"
                              Width="8"
                              Height="8"
                              Margin="0,4,0,6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{TemplateBinding Foreground}"
                              Data="M 0 5 L 8 5 L 4 0 Z"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RailBorder" Property="Background" Value="#17202B"/>
                                    <Setter TargetName="RailBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="RailBorder" Property="Background" Value="#101826"/>
                                    <Setter TargetName="RailBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>

                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RailBorder" Property="Background" Value="#0F172A"/>
                                    <Setter TargetName="RailBorder" Property="BorderBrush" Value="#334155"/>
                                    <Setter Property="Foreground" Value="#CBD5E1"/>

                                    <Setter TargetName="TopArrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" CenterX="4" CenterY="2.5"/>
                                        </Setter.Value>
                                    </Setter>

                                    <Setter TargetName="BottomArrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" CenterX="4" CenterY="2.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="RailBorder" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GridCellTextBlockStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="GridCellTextCenterStyle" TargetType="TextBlock" BasedOn="{StaticResource GridCellTextBlockStyle}">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="GridCellTextRightStyle" TargetType="TextBlock" BasedOn="{StaticResource GridCellTextBlockStyle}">
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
            <Style x:Key="StatusHistoryTextStyle"
       TargetType="TextBlock"
       BasedOn="{StaticResource GridCellTextBlockStyle}">
                <Setter Property="FontSize" Value="10.5"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="#0F172A">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
        Background="{StaticResource HeaderBrush}"
        BorderBrush="#223044"
        BorderThickness="0,0,0,1"
        Padding="10,10,10,10">

            <DockPanel LastChildFill="True">

                <!-- LEFT TOOLBAR -->
                <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Left"
                    VerticalAlignment="Center">

                    <!-- Group 1 -->
                    <Button Style="{StaticResource ToolbarCommandButtonStyle}"
                    IsEnabled="{Binding CanEditSettings}"
                    Click="ConnectionSetup_Click">
                        <StackPanel>
                            <TextBlock Text="◉"
                               FontSize="15"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                            <TextBlock Text="Setup"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarCommandPrimaryButtonStyle}"
                    Command="{Binding ConnectCommand}">
                        <StackPanel>
                            <TextBlock Text="⟲"
                               FontSize="15"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                            <TextBlock Text="Connect"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarCommandButtonStyle}"
                    Command="{Binding DisconnectCommand}">
                        <StackPanel>
                            <TextBlock Text="✕"
                               FontSize="15"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                            <TextBlock Text="Disconnect"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}"/>

                    <!-- Group 2 -->
                    <Button Style="{StaticResource ToolbarCommandButtonStyle}"
                    Click="LineMonitor_Click">
                        <StackPanel>
                            <TextBlock Text="≣"
                               FontSize="15"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                            <TextBlock Text="Line Monitor"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarCommandButtonStyle}"
                    Click="BufferAudit_Click">
                        <StackPanel>
                            <TextBlock Text="SOE"
                               FontSize="13"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                            <TextBlock Text="Buffer Audit"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarCommandButtonStyle}"
                    Click="NucRedundancy_Click">
                        <StackPanel>
                            <TextBlock Text="NUC"
                               FontSize="13"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                            <TextBlock Text="Redundancy"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarCommandButtonStyle}"
                    Click="Availability_Click">
                        <StackPanel>
                            <TextBlock Text="48h"
                               FontSize="13"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                            <TextBlock Text="Availability"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="FindingsButton"
                    Style="{StaticResource ToolbarCommandButtonStyle}"
                    Click="Findings_Click">
                        <StackPanel>
                            <TextBlock Text="!"
                               FontSize="15"
                               Style="{StaticResource ToolbarIconTextStyle}"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="Findings"
                                   Style="{StaticResource ToolbarIconTextStyle}"/>
                                <Ellipse x:Name="FindingsAlertDot"
                                         Width="8"
                                         Height="8"
                                         Margin="6,0,0,0"
                                         Fill="#F59E0B"
                                         Stroke="#FDE68A"
                                         StrokeThickness="1"
                                         Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- RIGHT STATUS AREA -->
                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                    <Border Style="{StaticResource HeaderChipBorderStyle}" Margin="0,0,8,0">
                        <TextBlock Foreground="#D8E2EE"
                           Text="{Binding ActiveModeInfo}"/>
                    </Border>

                    <Button Width="34"
        Height="34"
        Margin="0,0,8,0"
        Click="About_Click"
        ToolTip="About"
        Style="{StaticResource RoundIconButtonStyle}">
                        <TextBlock Text="?"
               FontSize="15"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                    </Button>

                    <Border Style="{StaticResource HeaderChipBorderStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                <Ellipse Width="10" Height="10" Margin="0,0,4,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#64748B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTxActive}" Value="True">
                                                    <Setter Property="Fill" Value="#F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Foreground="#D8E2EE"
                                   Text="TX"
                                   VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,4,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#64748B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRxActive}" Value="True">
                                                    <Setter Property="Fill" Value="#10B981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Foreground="#D8E2EE"
                                   Text="RX"
                                   VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,7"
                    Background="{StaticResource AccentDarkBrush}"
                    CornerRadius="14">
                        <TextBlock Foreground="White"
                           FontWeight="SemiBold"
                           Text="{Binding ConnectionStatus}"/>
                    </Border>
                </StackPanel>

            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition x:Name="LeftPaneColumn" Width="0.85*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                <ColumnDefinition x:Name="RightPaneColumn" Width="1.12*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <ToggleButton x:Name="LeftRailToggle"
              Grid.Column="0"
                          Width="20"
              Content="Minimize Value Viewer"
              IsChecked="True"
              Checked="LeftRailToggle_Checked"
              Unchecked="LeftRailToggle_Unchecked"
              Style="{StaticResource VerticalRailToggleButtonStyle}"/>

            <ToggleButton x:Name="RightRailToggle"
              Grid.Column="4" Width="20"
              Content="Minimize Event Log"
              IsChecked="True"
              Checked="RightRailToggle_Checked"
              Unchecked="RightRailToggle_Unchecked"
              Style="{StaticResource VerticalRailToggleButtonRightStyle}"/>

            <Grid x:Name="LeftPaneHost" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Expander Grid.Row="0" Style="{StaticResource DarkExpanderStyle}" IsExpanded="False" Margin="0,0,0,8" Background="#111827" BorderBrush="#334155" BorderThickness="1" Foreground="#E2E8F0">
                    <Expander.Header>
                        <TextBlock Text="Command Panel" Margin="5,5,0,5"/>
                    </Expander.Header>
                    <Border Padding="10" Background="#111827">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Width="140" Height="30" Margin="0,0,8,8" Style="{StaticResource TactileSecondaryButtonStyle}" Content="Send GI" Command="{Binding SendGeneralInterrogationCommand}" />
                                <Button Width="140" Height="30" Margin="0,0,8,8" Style="{StaticResource TactileSecondaryButtonStyle}" Content="Send Clock Sync" Command="{Binding SendClockSyncCommand}" />
                                <Button Width="120" Height="30" Margin="0,0,8,8" Style="{StaticResource TactileSecondaryButtonStyle}" Content="Clear Values" Command="{Binding ClearValuesCommand}" />
                                <Button Width="120" Height="30" Margin="0,0,8,8" Style="{StaticResource TactileSecondaryButtonStyle}" Content="Clear Events" Command="{Binding ClearEventLogCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <Border Grid.Row="1" Style="{StaticResource PanelSectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource PanelHeaderBarStyle}">
                            <TextBlock Text="Value Viewer" Style="{StaticResource PanelHeaderTextStyle}" Margin="5,5,0,5"/>
                        </Border>
                        <DataGrid Grid.Row="1" Margin="6,6,6,6" x:Name="ValueViewerGrid" ItemsSource="{Binding Values}" SelectedItem="{Binding SelectedValue}" MouseDoubleClick="ValueViewer_MouseDoubleClick" SizeChanged="MainDataGrid_SizeChanged" Style="{StaticResource PanelDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IOA"
                        Binding="{Binding IOA}"
                        Width="70"
                        ElementStyle="{StaticResource GridCellTextCenterStyle}" />

                                <DataGridTextColumn Header="Name / Label"
                        Binding="{Binding Name}"
                        Width="1.4*"
                        MinWidth="120"
                        ElementStyle="{StaticResource GridCellTextBlockStyle}" />

                                <DataGridTextColumn Header="Type"
                        Binding="{Binding Type}"
                        Width="120"
                        ElementStyle="{StaticResource GridCellTextBlockStyle}" />

                                <DataGridTemplateColumn Header="Value" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,2"
                        CornerRadius="10"
                        Background="#162132"
                        HorizontalAlignment="Center">
                                                <TextBlock x:Name="ValueText"
                               Text="{Binding Value}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#E2E8F0"
                               FontWeight="SemiBold" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Value}" Value="ON">
                                                    <Setter TargetName="ValueText" Property="Foreground" Value="#F87171" />
                                                    <Setter TargetName="ValueText" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="OFF">
                                                    <Setter TargetName="ValueText" Property="Foreground" Value="#4ADE80" />
                                                    <Setter TargetName="ValueText" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="OPEN">
                                                    <Setter TargetName="ValueText" Property="Foreground" Value="#4ADE80" />
                                                    <Setter TargetName="ValueText" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="CLOSE">
                                                    <Setter TargetName="ValueText" Property="Foreground" Value="#F87171" />
                                                    <Setter TargetName="ValueText" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Quality"
                        Binding="{Binding Quality}"
                        Width="80"
                        ElementStyle="{StaticResource GridCellTextCenterStyle}" />

                                <DataGridTextColumn Header="Slave Timestamp"
                        Binding="{Binding Timestamp}"
                        Width="SizeToCells"
                        MinWidth="155"
                        ElementStyle="{StaticResource GridCellTextBlockStyle}" />

                                <DataGridTextColumn Header="COT"
                        Binding="{Binding Cot}"
                        Width="75"
                        ElementStyle="{StaticResource GridCellTextCenterStyle}" />

                                <DataGridTextColumn Header="Class"
                        Binding="{Binding TrafficClass}"
                        Width="75"
                        ElementStyle="{StaticResource GridCellTextCenterStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Expander Grid.Row="2" Style="{StaticResource DarkExpanderStyle}" IsExpanded="False" Margin="0,8,0,0" Background="#111827" BorderBrush="#334155" BorderThickness="1" Foreground="#E2E8F0">
                    <Expander.Header>
                        <TextBlock Text="Signal Command" Margin="5,5,0,5"/>
                    </Expander.Header>
                    <Border Padding="10" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ComboBox Width="220"
                                          Margin="0,0,0,8"
                                          Style="{StaticResource DarkPopupComboBoxStyle}"
                                          ItemsSource="{Binding CommandSignals}"
                                          SelectedItem="{Binding SelectedValue}"
                                          DisplayMemberPath="Name" />
                                <TextBlock FontWeight="SemiBold" Foreground="#F8FAFC" Text="{Binding SelectedValue.Name}" />
                                <TextBlock Margin="0,4,0,0" Foreground="#CBD5E1" Text="{Binding SelectedValue.Type}" />
                                <TextBlock Margin="0,4,0,0" Foreground="#94A3B8" Text="Select a Single Point, Double Point, or Step Position row to open a focused DO/SBO command popup." />
                            </StackPanel>
                            <Button Grid.Column="1" Width="130" Height="32" Margin="12,0,0,0" Style="{StaticResource TactilePrimaryButtonStyle}" Content="Open Command" Click="OpenSelectedSignalCommand_Click" />
                        </Grid>
                    </Border>
                </Expander>
            </Grid>

            <GridSplitter x:Name="MainGridSplitter" Grid.Column="2" Width="3" HorizontalAlignment="Stretch" Background="Black" />

            <Grid x:Name="RightPaneHost" Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,4" Style="{StaticResource PanelSectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource PanelHeaderBarStyle}">
                            <TextBlock Text="Event Log" Style="{StaticResource PanelHeaderTextStyle}" Margin="5,5,0,5"/>
                        </Border>
                        <DataGrid Grid.Row="1" Margin="6,6,6,6" x:Name="EventLogGrid" ItemsSource="{Binding EventLog}" SizeChanged="MainDataGrid_SizeChanged" Style="{StaticResource PanelDataGridStyle}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source}" Value="Master">
                                            <Setter Property="Background" Value="#0D2A4A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Source}" Value="RTU">
                                            <Setter Property="Background" Value="#0D3A2A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Source}" Value="System">
                                            <Setter Property="Background" Value="#1A2230"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No"
                        Binding="{Binding No}"
                        Width="45"
                        ElementStyle="{StaticResource GridCellTextCenterStyle}" />

                                <DataGridTextColumn Header="Time"
                        Binding="{Binding Time}"
                        Width="155"
                        ElementStyle="{StaticResource GridCellTextBlockStyle}" />

                                <DataGridTextColumn Header="Name"
                        Binding="{Binding Name}"
                        Width="95"
                        ElementStyle="{StaticResource GridCellTextBlockStyle}" />

                                <DataGridTextColumn Header="IOA"
                        Binding="{Binding IOA}"
                        Width="70"
                        ElementStyle="{StaticResource GridCellTextCenterStyle}" />

                                <DataGridTextColumn Header="Type"
                        Binding="{Binding Type}"
                        Width="105"
                        ElementStyle="{StaticResource GridCellTextBlockStyle}" />

                                <DataGridTextColumn Header="Event"
                        Binding="{Binding Event}"
                        Width="240"
                        ElementStyle="{StaticResource GridCellTextBlockStyle}" />

                                <DataGridTemplateColumn Header="Value" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,2"
                        CornerRadius="10"
                        Background="#162132"
                        HorizontalAlignment="Center">
                                                <TextBlock x:Name="EventValueText"
                               Text="{Binding Value}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#E2E8F0" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Value}" Value="OFF -> ON">
                                                    <Setter TargetName="EventValueText" Property="Foreground" Value="#F87171" />
                                                    <Setter TargetName="EventValueText" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="ON -> OFF">
                                                    <Setter TargetName="EventValueText" Property="Foreground" Value="#4ADE80" />
                                                    <Setter TargetName="EventValueText" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="OPEN">
                                                    <Setter TargetName="EventValueText" Property="Foreground" Value="#4ADE80" />
                                                    <Setter TargetName="EventValueText" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="CLOSE">
                                                    <Setter TargetName="EventValueText" Property="Foreground" Value="#F87171" />
                                                    <Setter TargetName="EventValueText" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Class"
                        Binding="{Binding DataClass}"
                        Width="60"
                        ElementStyle="{StaticResource GridCellTextCenterStyle}" />

                                <DataGridTextColumn Header="COT"
                        Binding="{Binding Cot}"
                        Width="70"
                        ElementStyle="{StaticResource GridCellTextCenterStyle}" />

                                <DataGridTextColumn Header="Quality"
                        Binding="{Binding Quality}"
                        Width="70"
                        ElementStyle="{StaticResource GridCellTextCenterStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#334155" />

                <Expander Grid.Row="2" Style="{StaticResource DarkExpanderStyle}" IsExpanded="True" Background="#111827" BorderBrush="#334155" BorderThickness="1" Foreground="#E2E8F0">
                    <Expander.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Status History" Margin="6,5,20,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                <Ellipse Width="10" Height="10" Fill="#DC2626" Margin="0,0,4,0" />
                                <TextBlock Foreground="#E2E8F0" Text="Error" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,4,0" />
                                <TextBlock Foreground="#E2E8F0" Text="Warn" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#0EA5E9" Margin="0,0,4,0" />
                                <TextBlock Foreground="#E2E8F0" Text="Info" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Expander.Header>
                    <Grid Margin="6,4,6,6">
                        <DataGrid x:Name="StatusHistoryGrid"
          Margin="0"
          Height="112"
          FontSize="10.5"
          RowHeight="24"
          ColumnHeaderHeight="28"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserResizeRows="False"
          CanUserReorderColumns="False"
          HeadersVisibility="Column"
          ItemsSource="{Binding StatusHistory}"
          SizeChanged="MainDataGrid_SizeChanged"
          Style="{StaticResource PanelDataGridStyle}"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBarStyle}" />
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Lvl" Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="9"
                             Height="9"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#0EA5E9" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                <Setter Property="Fill" Value="#DC2626" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                                <Setter Property="Fill" Value="#F59E0B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Time"
                            Binding="{Binding Time}"
                            Width="1.00*"
                            ElementStyle="{StaticResource GridCellTextBlockStyle}" />

                                <DataGridTextColumn Header="Status"
                            Binding="{Binding Status}"
                            Width="0.85*"
                            ElementStyle="{StaticResource GridCellTextBlockStyle}" />

                                <DataGridTextColumn Header="Detail"
                            Binding="{Binding Detail}"
                            Width="1.90*"
                            ElementStyle="{StaticResource GridCellTextBlockStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Expander>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2" Background="#0F172A" Foreground="#E2E8F0">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentProfileSummary}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ConnectionDetail}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>









