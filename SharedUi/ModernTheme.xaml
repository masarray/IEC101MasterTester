<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- Palette -->
    <SolidColorBrush x:Key="AppBgBrush" Color="#EEF2F6"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#17202B"/>
    <SolidColorBrush x:Key="HeaderAltBrush" Color="#223042"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#14B8A6"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#0F766E"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSubBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextDarkBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#111827"/>
    <SolidColorBrush x:Key="PopupSurfaceAltBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="PopupInputBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="PopupMutedBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="PopupInputBorderBrush" Color="#475569"/>
    <SolidColorBrush x:Key="PopupInputHoverBorderBrush" Color="#14B8A6"/>
    <SolidColorBrush x:Key="PopupInputDisabledBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="PopupInputDisabledTextBrush" Color="#64748B"/>

    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#14B8A6"/>
    <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#0F9F94"/>

    <!-- Tokens -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">8</CornerRadius>
    <sys:Double x:Key="DefaultControlHeight">34</sys:Double>
    <sys:Double x:Key="DefaultScrollBarThickness">12</sys:Double>
    
    <!-- Panel -->
    <Style x:Key="ModernPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="TactilePrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.22"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="4"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#0EA5A0"/>
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#0EA5A0"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentDarkBrush}"/>
                            <Setter TargetName="BtnBorder" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="BtnBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TactileSecondaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource TactilePrimaryButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="Background" Value="{StaticResource HeaderAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PopupBorderBrush}"/>
    </Style>

    <Style x:Key="HeaderChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HeaderAltBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- Popup labels -->
    <Style x:Key="DarkPopupTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Popup TextBox -->
    <Style x:Key="DarkPopupTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="Background" Value="{StaticResource PopupSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PopupInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{StaticResource DefaultControlHeight}"/>
        <Setter Property="MinHeight" Value="{StaticResource DefaultControlHeight}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="#334155"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PopupInputHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PopupInputHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource PopupInputDisabledTextBrush}"/>
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PopupInputDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Popup ComboBox Item -->
    <Style x:Key="DarkPopupComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="Background" Value="{StaticResource PopupSurfaceBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HeaderAltBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource PopupInputDisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Popup ComboBox -->
    <Style x:Key="DarkPopupComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="Background" Value="{StaticResource PopupSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PopupInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{StaticResource DefaultControlHeight}"/>
        <Setter Property="MinHeight" Value="{StaticResource DefaultControlHeight}"/>
        <Setter Property="Padding" Value="10,0,36,0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkPopupComboBoxItemStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>

                            <!-- Non-editable content -->
                            <ContentPresenter x:Name="ContentSite"
                                          Grid.Column="0"
                                          Margin="10,0,8,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          IsHitTestVisible="False"/>

                            <!-- Editable textbox -->
                            <TextBox x:Name="PART_EditableTextBox"
                                 Grid.Column="0"
                                 Margin="10,0,6,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 VerticalContentAlignment="Center"
                                 Visibility="Hidden"/>

                            <!-- Full-surface click target for non-editable mode -->
                            <ToggleButton x:Name="FullSurfaceToggle"
              Grid.ColumnSpan="2"
              Focusable="False"
              ClickMode="Press"
              Background="Transparent"
              BorderThickness="0"
              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Right arrow button -->
                            <ToggleButton x:Name="DropDownToggle"
              Grid.Column="1"
              Focusable="False"
              ClickMode="Press"
              Background="{StaticResource HeaderAltBrush}"
              BorderBrush="{StaticResource PopupInputBorderBrush}"
              BorderThickness="1,0,0,0"
              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="0,4,4,0">
                                            <Path Width="10"
                      Height="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{StaticResource TextSubBrush}"
                      Data="M 0 0 L 10 0 L 5 6 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>

                        <Popup x:Name="Popup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           PopupAnimation="Fade">
                            <Border Margin="0,4,0,0"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                Background="{StaticResource PopupSurfaceBrush}"
                                BorderBrush="{StaticResource PopupInputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <ScrollViewer MaxHeight="260"
                                          SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PopupInputHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PopupInputHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PopupInputHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FullSurfaceToggle" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource PopupInputDisabledTextBrush}"/>
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PopupInputDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkPopupComboBoxStyle}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkPopupComboBoxItemStyle}"/>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource PopupSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PopupBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#1C2A40"/>
        <Setter Property="VerticalGridLinesBrush" Value="#1C2A40"/>
        <Setter Property="RowBackground" Value="{StaticResource PopupSurfaceBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource PopupSurfaceAltBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
        <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
        <Setter Property="CanUserReorderColumns" Value="True"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PopupBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderBrush" Value="#1C2A40"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- Popup CheckBox -->
    <Style x:Key="DarkPopupCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Border x:Name="CheckBorder"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    Background="{StaticResource PopupSurfaceBrush}"
                                    BorderBrush="{StaticResource PopupInputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <Path x:Name="CheckGlyph"
                                      Visibility="Collapsed"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2"
                                      Data="M 3 8 L 6.5 11.5 L 13 4.5"/>
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource PopupInputHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource PopupInputDisabledTextBrush}"/>
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource PopupInputDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Popup GroupBox -->
    <Style x:Key="DarkPopupGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PopupBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Border Margin="0,12,0,0"
                                Background="{StaticResource PopupSurfaceAltBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PanelCornerRadius}"/>
                        <Border Margin="12,0,0,0"
                                Padding="8,0"
                                HorizontalAlignment="Left"
                                Background="{StaticResource PopupSurfaceAltBrush}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ContentPresenter Margin="12,24,12,12"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar -->
    <Style x:Key="MinimalScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Background="{StaticResource ScrollThumbBrush}"
                            CornerRadius="5"
                            Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollThumbPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="{StaticResource ScrollTrackBrush}"
              Width="{StaticResource DefaultScrollBarThickness}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource MinimalScrollBarThumbStyle}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="{StaticResource ScrollTrackBrush}"
              Height="{StaticResource DefaultScrollBarThickness}">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource MinimalScrollBarThumbStyle}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}"/>
        <Setter Property="Width" Value="{StaticResource DefaultScrollBarThickness}"/>
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="{StaticResource DefaultScrollBarThickness}"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
