<Window x:Class="IEC101MasterTester.SharedUi.DemoModeAlert"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="License Status"
        Height="704"
        Width="1169"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="BgMain" Color="#0F172A"/>
        <SolidColorBrush x:Key="CardBg" Color="#111827"/>
        <SolidColorBrush x:Key="Accent" Color="#14B8A6"/>
        <SolidColorBrush x:Key="AccentDark" Color="#0F766E"/>
        <SolidColorBrush x:Key="AccentHover" Color="#0EA5A0"/>
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSub" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#334155"/>
        <SolidColorBrush x:Key="PanelSoft" Color="#0B1220"/>
        <SolidColorBrush x:Key="WarningSoft" Color="#1E293B"/>
        <SolidColorBrush x:Key="WarningAccent" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerAccent" Color="#EF4444"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="OutlineWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerActionButtonStyle}">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderBrush" Value="{StaticResource WarningAccent}"/>
            <Setter Property="Foreground" Value="#FCD34D"/>
        </Style>

        <Style x:Key="TextInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style x:Key="ReadOnlyValueBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelSoft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Minimal premium scrollbar -->
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#0B1220"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#334155"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#14B8A6"/>
        <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#0F9F94"/>

        <Style x:Key="MinimalScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{StaticResource ScrollThumbBrush}"
                                CornerRadius="5"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{StaticResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{StaticResource ScrollThumbPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Background="{StaticResource ScrollTrackBrush}" Width="12">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                      Opacity="0"
                                      IsTabStop="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource MinimalScrollBarThumbStyle}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                      Opacity="0"
                                      IsTabStop="False"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Background="{StaticResource ScrollTrackBrush}" Height="12">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                      Opacity="0"
                                      IsTabStop="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource MinimalScrollBarThumbStyle}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                      Opacity="0"
                                      IsTabStop="False"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BgMain}">
        <Grid.RowDefinitions>
            <RowDefinition Height="108"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="74"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <Border Width="64"
                        Height="64"
                        VerticalAlignment="Center"
                        CornerRadius="12"
                        Background="#0B1220"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1">
                    <Viewbox Margin="14">
                        <Grid Width="32" Height="32">
                            <Ellipse Fill="#14B8A6" Opacity="0.18"/>
                            <Path Data="M16,2 A14,14 0 1 1 15.9,2 M16,7 L16,18 M16,23 L16,24"
                                  Stroke="#14B8A6"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="14,0,24,0">
                    <TextBlock Text="Evaluation Mode"
                               Foreground="{StaticResource TextMain}"
                               FontSize="26"
                               FontWeight="Bold"/>
                    <TextBlock Text="This application is running under evaluation restrictions. Activate the license to unlock uninterrupted engineering workflow."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12.8"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Background="#0B1220"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Trial day 12 / 30"
                                   Foreground="{StaticResource TextMain}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="State: Evaluation Mode"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="12"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.25*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left -->
            <ScrollViewer Grid.Column="0"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Margin="0,0,18,0"
              Padding="0">
                <StackPanel Margin="0,0,6,0">

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Current Status" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}">
This software is currently running in evaluation mode. Core protocol visibility remains available for review and testing, while selected advanced capabilities remain restricted until activation.
                            </TextBlock>

                            <Border Margin="0,16,0,0"
                                    Background="{StaticResource WarningSoft}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Status Summary"
                                               Foreground="#FCD34D"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Style="{StaticResource BodyTextStyle}"
                                               Text="Continue in Demo will become available after the short countdown. You may also activate immediately using a valid serial key."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Demo Restrictions" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"
                                       Text="• Advanced export and long-form reporting are disabled in evaluation mode."/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"
                                       Text="• Long-duration session features and selected advanced redundancy tools may be limited."/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"
                                       Text="• A reminder dialog may appear periodically while evaluation mode is active."/>
                            <TextBlock Style="{StaticResource BodyTextStyle}"
                                       Text="• Activation removes these restrictions for the licensed machine."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Why Activate" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"
                                       Text="• Uninterrupted engineering workflow during FAT, SAT, and troubleshooting"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"
                                       Text="• Access to advanced diagnostics, redundancy analysis, and extended session handling"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"
                                       Text="• Full reporting, export capability, and maintenance support discussions"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}"
                                       Text="• Stable licensed experience bound to the target machine hardware fingerprint"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Activation" Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Hardware ID" Style="{StaticResource LabelStyle}"/>
                            <Border Style="{StaticResource ReadOnlyValueBorderStyle}">
                                <DockPanel>
                                    <TextBlock Text="HWID-3A92-7C4F-91D8-8F21"
                                               Foreground="{StaticResource TextMain}"
                                               FontFamily="Consolas"
                                               FontSize="13.2"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Content="Copy HWID"
                                            Width="96"
                                            Height="30"
                                            HorizontalAlignment="Right"
                                            DockPanel.Dock="Right"
                                            Margin="12,0,0,0"
                                            Style="{StaticResource CompactInlineButtonStyle}"/>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Serial Key" Style="{StaticResource LabelStyle}" Margin="0,16,0,0"/>
                            <TextBox Style="{StaticResource TextInputStyle}"
                                     Text="Enter serial key here..."
                                     Foreground="{StaticResource TextMuted}"/>

                            <TextBlock Text="Contact" Style="{StaticResource LabelStyle}" Margin="0,16,0,0"/>
                            <Border Style="{StaticResource ReadOnlyValueBorderStyle}">
                                <TextBlock Text="admin@arisulistiono.com"
                                           Foreground="{StaticResource TextMain}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right -->
            <ScrollViewer Grid.Column="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Padding="0">
                <StackPanel>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="License Summary" Style="{StaticResource SectionTitleStyle}"/>

                            <Grid Margin="0,2,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="State" Style="{StaticResource LabelStyle}" Margin="0,0,0,10"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Evaluation Mode" Style="{StaticResource ValueStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Machine" Style="{StaticResource LabelStyle}" Margin="0,0,0,10"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Local Device" Style="{StaticResource ValueStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Trial Start" Style="{StaticResource LabelStyle}" Margin="0,0,0,10"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="2026-03-01" Style="{StaticResource ValueStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Days Left" Style="{StaticResource LabelStyle}" Margin="0,0,0,10"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="18 days remaining" Style="{StaticResource ValueStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Tamper" Style="{StaticResource LabelStyle}" Margin="0,0,0,10"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="No integrity issue detected" Style="{StaticResource ValueStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="HWID" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Text="HWID-3A92-7C4F-91D8-8F21"
                                           Foreground="{StaticResource TextMain}"
                                           FontFamily="Consolas"
                                           FontSize="12.8"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="86"
                                    Height="86"
                                    CornerRadius="43"
                                    Background="#0B1220"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    Margin="0,0,0,12">
                                <Viewbox Margin="18">
                                    <Grid Width="32" Height="32">
                                        <Path Data="M16,2 A14,14 0 1 1 15.9,2"
                                              Stroke="{StaticResource Accent}"
                                              StrokeThickness="2.2"/>
                                        <Path Data="M16,8 L16,17"
                                              Stroke="{StaticResource Accent}"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                        <Ellipse Width="2.8" Height="2.8" Fill="{StaticResource Accent}" Margin="14.6,21.2,0,0"/>
                                    </Grid>
                                </Viewbox>
                            </Border>

                            <TextBlock Text="Continue in Demo"
                                       Foreground="{StaticResource TextMain}"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Available in 00:10"
                                       Foreground="{StaticResource Accent}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>

                            <TextBlock Text="You may continue with evaluation restrictions after the short acknowledgement delay."
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12.2"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Support and Activation" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="12.5">
For activation, update support, maintenance, or feature discussion, please contact the licensing administrator.
                            </TextBlock>

                            <Border Margin="0,14,0,0"
                                    Background="{StaticResource PanelSoft}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <TextBlock Text="admin@arisulistiono.com"
                                           Foreground="{StaticResource TextMain}"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="2"
                Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="1,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12.5"
                           Text="Evaluation mode keeps the application usable for review while selected advanced capabilities remain restricted."/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Copy HWID"
                            Style="{StaticResource CompactInlineButtonStyle}"
                            Margin="0,0,10,0"/>

                    <Button Content="Continue in Demo (10)"
                            Style="{StaticResource OutlineWarningButtonStyle}"
                            IsEnabled="False"
                            Margin="0,0,10,0"/>

                    <Button Content="Activate License"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
