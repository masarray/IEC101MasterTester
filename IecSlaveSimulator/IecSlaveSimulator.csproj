<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>IecSlaveSimulator</RootNamespace>
    <AssemblyName>IecSlaveSimulator</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <StartupObject>IecSlaveSimulator.App</StartupObject>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Numerics" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\SharedUi\AboutWindow.xaml" Link="SharedUi\AboutWindow.xaml" />
    <Page Include="..\SharedUi\ModernTheme.xaml" Link="SharedUi\ModernTheme.xaml" />
    <Compile Include="..\SharedUi\AboutWindow.xaml.cs" Link="SharedUi\AboutWindow.xaml.cs">
      <DependentUpon>AboutWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Services\Iec101\Native\Iec101ApplicationProfile.cs" Link="SharedNative\Iec101ApplicationProfile.cs" />
    <Compile Include="..\Services\Iec101\Native\Asdu\*.cs" Link="SharedNative\Asdu\%(Filename)%(Extension)" />
    <Compile Include="..\Services\Iec101\Native\Frames\*.cs" Link="SharedNative\Frames\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\SharedUi\Assets\Icons\app-icon.png" Link="SharedUi\Assets\Icons\app-icon.png" />
    <Resource Include="..\SharedUi\Assets\Profile\ari-profile.jpg" Link="SharedUi\Assets\Profile\ari-profile.jpg" />
  </ItemGroup>
</Project>




