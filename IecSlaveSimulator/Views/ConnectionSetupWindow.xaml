<Window x:Class="IecSlaveSimulator.Views.ConnectionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slave Connection Setup"
        Width="620"
        Height="760"
        MinWidth="580"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0F172A">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="12" Background="#0F172A">
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#FCA5A5" TextWrapping="Wrap" Text="{Binding ValidationMessage}" />
                <Button Grid.Column="1" Width="92" Height="32" Margin="0,0,8,0" Style="{StaticResource TactilePrimaryButtonStyle}" Content="Save" IsDefault="True" Click="Save_Click" />
                <Button Grid.Column="2" Width="92" Height="32" Style="{StaticResource TactileSecondaryButtonStyle}" Content="Cancel" IsCancel="True" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0F172A">
            <Grid Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Serial Port" />
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4,8,4" MinWidth="0" HorizontalAlignment="Stretch" Style="{StaticResource DarkPopupComboBoxStyle}" ItemsSource="{Binding SerialPortOptions}" SelectedItem="{Binding SerialPort}" />
                <Button Grid.Row="0" Grid.Column="2" Width="86" Height="28" Margin="0,4,0,4" Style="{StaticResource TactileSecondaryButtonStyle}" Content="Refresh" Click="RefreshPorts_Click" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Baud Rate" />
                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" MinWidth="0" HorizontalAlignment="Stretch" Style="{StaticResource DarkPopupComboBoxStyle}" ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding BaudRate}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Data Bits" />
                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" MinWidth="0" HorizontalAlignment="Stretch" Style="{StaticResource DarkPopupComboBoxStyle}" ItemsSource="{Binding DataBitOptions}" SelectedItem="{Binding DataBits}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Parity" />
                <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" MinWidth="0" HorizontalAlignment="Stretch" Style="{StaticResource DarkPopupComboBoxStyle}" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Stop Bits" />
                <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" MinWidth="0" HorizontalAlignment="Stretch" Style="{StaticResource DarkPopupComboBoxStyle}" ItemsSource="{Binding StopBitOptions}" SelectedItem="{Binding StopBits}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Link Layer Mode" />
                <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" MinWidth="0" HorizontalAlignment="Stretch" Style="{StaticResource DarkPopupComboBoxStyle}" ItemsSource="{Binding LinkLayerModeOptions}" SelectedItem="{Binding LinkLayerMode}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Link Address Length" />
                <ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" MinWidth="0" HorizontalAlignment="Stretch" Style="{StaticResource DarkPopupComboBoxStyle}" ItemsSource="{Binding LinkAddressLengthOptions}" SelectedItem="{Binding LinkAddressLength}" />

                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Link Address" />
                <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" MinWidth="0" HorizontalAlignment="Stretch" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding LinkAddress}" />

                <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="CA Length / Common Address" />
                <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <ComboBox Width="110" Margin="0,4,8,4" Style="{StaticResource DarkPopupComboBoxStyle}" ItemsSource="{Binding CasduLengthOptions}" SelectedItem="{Binding CasduLength}" />
                    <TextBox Width="150" Margin="0,4,0,4" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding CommonAddress}" />
                </StackPanel>

                <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="IOA Length" />
                <ComboBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" MinWidth="0" HorizontalAlignment="Stretch" Style="{StaticResource DarkPopupComboBoxStyle}" ItemsSource="{Binding IoaLengthOptions}" SelectedItem="{Binding IoaLength}" />

                <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Originator Address" />
                <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" MinWidth="0" HorizontalAlignment="Stretch" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding OriginatorAddress}" />

                <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Response Timeout / Run Loop / Bg Publish (ms)" />
                <StackPanel Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <TextBox Width="110" Margin="0,4,8,4" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding ResponseTimeoutMs}" />
                    <TextBox Width="110" Margin="0,4,8,4" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding RunLoopDelayMs}" />
                    <TextBox Width="110" Margin="0,4,0,4" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding BackgroundPublishIntervalMs}" />
                </StackPanel>

                <TextBlock Grid.Row="12" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Class 1 Queue" />
                <TextBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" MinWidth="0" HorizontalAlignment="Stretch" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding Class1QueueSize}" />

                <CheckBox Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" Style="{StaticResource DarkPopupCheckBoxStyle}" IsChecked="{Binding EnableMeasurementStreaming}" Content="  Enable measurement streaming" />

                <Border Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,18,0,0" Padding="10" CornerRadius="8" Background="#12261F" BorderBrush="#10B981" BorderThickness="1">
                    <TextBlock Foreground="#A7F3D0" FontWeight="SemiBold" Text="Slave NUC Foundation" />
                </Border>

                <TextBlock Grid.Row="15" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Operating Mode" />
                <ComboBox Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" MinWidth="0" HorizontalAlignment="Stretch" Style="{StaticResource DarkPopupComboBoxStyle}" ItemsSource="{Binding OperatingModeOptions}" SelectedItem="{Binding OperatingMode}" />

                <TextBlock Grid.Row="16" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Backup Serial / Shared Link Address" />
                <StackPanel Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <ComboBox Width="180" Margin="0,4,8,4" Style="{StaticResource DarkPopupComboBoxStyle}" ItemsSource="{Binding SerialPortOptions}" SelectedItem="{Binding BackupSerialPort}" />
                    <TextBox Width="120" Margin="0,4,0,4" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding BackupLinkAddress}" />
                </StackPanel>

                <TextBlock Grid.Row="17" Grid.Column="0" Margin="0,6,12,6" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Buffer Injection" />
                <StackPanel Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <ComboBox Width="180" Margin="0,4,8,4" Style="{StaticResource DarkPopupComboBoxStyle}" ItemsSource="{Binding BufferInjectionModeOptions}" SelectedItem="{Binding BufferInjectionMode}" />
                    <TextBox Width="90" Margin="0,4,8,4" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding BufferInjectionSignalCount}" />
                    <TextBox Width="90" Margin="0,4,8,4" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding BufferInjectionBurstSize}" />
                    <TextBox Width="90" Margin="0,4,0,4" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding BufferInjectionIntervalMs}" />
                </StackPanel>

                <CheckBox Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" Style="{StaticResource DarkPopupCheckBoxStyle}" IsChecked="{Binding EmitGatewayBaselineOnStart}" Content="  Emit L1FT/L2FT/IEDF baseline on start" />
                <CheckBox Grid.Row="19" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0" Style="{StaticResource DarkPopupCheckBoxStyle}" IsChecked="{Binding ShareEventBufferAcrossLinks}" Content="  Share event buffer across Link A and Link B" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
