<Window x:Class="IEC101MasterTester.Views.NucRedundancyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IEC-101 NUC Redundancy Test"
        Height="920"
        Width="1480"
        MinHeight="760"
        MinWidth="1220"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <SolidColorBrush x:Key="NucCardBrush" Color="#111A2B" />
            <SolidColorBrush x:Key="NucCardStrongBrush" Color="#162338" />
            <SolidColorBrush x:Key="NucInnerBrush" Color="#0E1625" />
            <SolidColorBrush x:Key="NucStrokeBrush" Color="#22314A" />
            <SolidColorBrush x:Key="NucTextBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="NucMutedBrush" Color="#94A3B8" />

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource NucCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NucStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource NucTextBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="RibbonChipBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#132033" />
                <Setter Property="BorderBrush" Value="#22314A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <Style x:Key="RibbonChipAccentBorderStyle" TargetType="Border" BasedOn="{StaticResource RibbonChipBorderStyle}">
                <Setter Property="Background" Value="#10251F" />
                <Setter Property="BorderBrush" Value="#1F7A4D" />
            </Style>

            <Style x:Key="RibbonChipInfoBorderStyle" TargetType="Border" BasedOn="{StaticResource RibbonChipBorderStyle}">
                <Setter Property="Background" Value="#102132" />
                <Setter Property="BorderBrush" Value="#24577A" />
            </Style>

            <Style x:Key="RibbonChipFaultBorderStyle" TargetType="Border" BasedOn="{StaticResource RibbonChipBorderStyle}">
                <Setter Property="Background" Value="#2A1518" />
                <Setter Property="BorderBrush" Value="#7F1D1D" />
            </Style>

            <Style x:Key="RibbonChipTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource NucTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="RibbonChipNumericTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RibbonChipTextStyle}">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <Style x:Key="RibbonCounterChipBorderStyle" TargetType="Border" BasedOn="{StaticResource RibbonChipBorderStyle}">
                <Setter Property="MinWidth" Value="128" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <Style x:Key="RibbonChipMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource NucMutedBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}" />
            <Style x:Key="ActionPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}" />
            <Style x:Key="ActionDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerActionButtonStyle}" />

            <Style x:Key="LineMonitorToggleButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#132033" />
                <Setter Property="BorderBrush" Value="#334155" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15">
                                <Grid>
                                    <Path x:Name="Chevron"
                                          Width="10"
                                          Height="10"
                                          Stroke="#E2E8F0"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M 2 4 L 5 7 L 8 4"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="LineMonitorDockChevronRotate" Angle="0" CenterX="5" CenterY="5" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <Ellipse Width="4"
                                             Height="4"
                                             Fill="#38BDF8"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="0,5,5,0"
                                             Opacity="0.0" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#38BDF8" />
                                    <Setter TargetName="Root" Property="Background" Value="#16263A" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#0F1A2A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LineMonitorGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource NucInnerBrush}" />
                <Setter Property="Foreground" Value="{StaticResource NucTextBrush}" />
                <Setter Property="BorderBrush" Value="#22314A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{StaticResource NucInnerBrush}" />
                <Setter Property="AlternatingRowBackground" Value="#101A2B" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource NucTextBrush}" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#16263A" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1D4E89" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource NucTextBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#16263A" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1D4E89" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="ZoomRootHost" Margin="14" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="WindowZoomTransform" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition x:Name="LineMonitorDockRow" Height="280" MinHeight="56" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Background="{StaticResource NucCardStrongBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="NUC Redundancy Test"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource NucTextBrush}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource NucMutedBrush}"
                               Text="{Binding RedundancyConfigSummaryText}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Right"
                           Margin="12,0,0,0">
                    <Button Width="108"
                            Margin="0,0,10,0"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="ConfigureLinks_Click"
                            ToolTip="Configure Links">
                        <StackPanel Orientation="Vertical">
                            <Path Width="20" Height="20" Stretch="Uniform" Stroke="#CFE5FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12 2 L20 6.5 L20 17.5 L12 22 L4 17.5 L4 6.5 Z M9 12 H15 M12 9 V15"/>
                            <TextBlock Margin="0,4,0,0" Text="Configure" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="108"
                            Margin="0,0,10,0"
                            Style="{StaticResource ActionPrimaryButtonStyle}"
                            IsEnabled="{Binding CanStartNucRedundancySessionButton}"
                            Click="StartSession_Click"
                            ToolTip="Start Session">
                        <StackPanel Orientation="Vertical">
                            <Path Width="20" Height="20" Stretch="Uniform" Stroke="#F8FAFC" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12 17 V21 M8 21 H16 M15 9.5 L10.5 12.2 V6.8 L15 9.5 M4 3 H20 A2 2 0 0 1 22 5 V15 A2 2 0 0 1 20 17 H4 A2 2 0 0 1 2 15 V5 A2 2 0 0 1 4 3 Z"/>
                            <TextBlock Margin="0,4,0,0" Text="Start Session" FontSize="10.5" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="108"
                            Margin="0,0,10,0"
                            Style="{StaticResource ActionDangerButtonStyle}"
                            IsEnabled="{Binding CanStopNucRedundancySessionButton}"
                            Click="StopSession_Click"
                            ToolTip="Stop Session">
                        <StackPanel Orientation="Vertical">
                            <Path Width="20" Height="20" Stretch="Uniform" Stroke="#FEE2E2" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M14.5 12.5 L9.5 7.5 M9.5 12.5 L14.5 7.5 M12 17 V21 M8 21 H16 M4 3 H20 A2 2 0 0 1 22 5 V15 A2 2 0 0 1 20 17 H4 A2 2 0 0 1 2 15 V5 A2 2 0 0 1 4 3 Z"/>
                            <TextBlock Margin="0,4,0,0" Text="Stop Session" FontSize="10.5" FontWeight="SemiBold" Foreground="#FEE2E2" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="94"
                            Margin="0,0,10,0"
                            Style="{StaticResource ActionButtonStyle}"
                            IsEnabled="{Binding CanStopNucRedundancySessionButton}"
                            Click="SendGi_Click"
                            ToolTip="Send General Interrogation">
                        <StackPanel Orientation="Vertical">
                            <Path Width="20" Height="20" Stretch="Uniform" Stroke="#CFE5FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M6 4 H18 M6 9 H18 M6 14 H12 M14 18 L17 21 L22 15"/>
                            <TextBlock Margin="0,4,0,0" Text="Send GI" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="94"
                            Margin="0,0,10,0"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OpenAvailabilityDashboard_Click"
                            ToolTip="Open Availability Dashboard">
                        <StackPanel Orientation="Vertical">
                            <Path Width="20" Height="20" Stretch="Uniform" Stroke="#CFE5FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4 18 H20 M7 16 V11 M12 16 V7 M17 16 V4"/>
                            <TextBlock Margin="0,4,0,0" Text="Availability" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="124"
                            Margin="0,0,10,0"
                            Style="{StaticResource ActionDangerButtonStyle}"
                            Click="ClearBufferEventStatistic_Click"
                            ToolTip="Clear Buffer, Event, and Statistic">
                        <StackPanel Orientation="Vertical">
                            <Path Width="20" Height="20" Stretch="Uniform" Stroke="#FEE2E2" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M5 7 H19 M9 7 V5 H15 V7 M8 10 V17 M12 10 V17 M16 10 V17 M7 7 L8 20 H16 L17 7"/>
                            <TextBlock Margin="0,4,0,0" Text="Clear Runtime" FontSize="10.5" FontWeight="SemiBold" Foreground="#FEE2E2" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="98"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,10,0"
                            Click="OpenMainWindow_Click"
                            ToolTip="Open Main Window">
                        <StackPanel Orientation="Vertical">
                            <Path Width="20" Height="20" Stretch="Uniform" Stroke="#CFE5FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4 5 H20 V19 H4 Z M8 9 H16 M8 13 H16"/>
                            <TextBlock Margin="0,4,0,0" Text="Main Window" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="90"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OpenSoeAudit_Click"
                            ToolTip="Open SOE Audit">
                        <StackPanel Orientation="Vertical">
                            <Path Width="20" Height="20" Stretch="Uniform" Stroke="#CFE5FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M7 4 H17 M7 8 H17 M7 12 H13 M5 3 H19 V21 H5 Z"/>
                            <TextBlock Margin="0,4,0,0" Text="SOE Audit" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
        Padding="12,8"
        Background="#0F1A2A"
        BorderThickness="1,1,1,3"
        CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#22314A" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NucLinkAVisual.StateText}" Value="Active">
                                <Setter Property="BorderBrush" Value="#22C55E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkAVisual.StateText}" Value="Standby">
                                <Setter Property="BorderBrush" Value="#38BDF8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkAVisual.StateText}" Value="Fault">
                                <Setter Property="BorderBrush" Value="#EF4444" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkAVisual.StateText}" Value="Offline">
                                <Setter Property="BorderBrush" Value="#EF4444" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkAVisual.StateText}" Value="Disconnected">
                                <Setter Property="BorderBrush" Value="#EF4444" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid ClipToBounds="True">
                    <!-- isi ribbon lama -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="MainLinkNameChip" Style="{StaticResource RibbonChipBorderStyle}">
                                        <TextBlock Text="LINK A" Style="{StaticResource RibbonChipTextStyle}" FontWeight="Bold" />
                                    </Border>

                                    <Border x:Name="MainStateChip" Style="{StaticResource RibbonChipAccentBorderStyle}"
        Width="90">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                 Width="8"
                 Height="8"
                 Margin="0,0,4,0"
                 VerticalAlignment="Center"
                 Fill="{Binding NucLinkAVisual.StateBrush}" />

                                            <TextBlock Grid.Column="1"
                   Text="{Binding NucLinkAVisual.StateText}"
                   Style="{StaticResource RibbonChipTextStyle}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource RibbonChipBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucMainTxRecent}" Value="True">
                                                                <Setter Property="Fill" Value="#F59E0B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="TX" Style="{StaticResource RibbonChipMutedTextStyle}" Margin="0,0,8,0" />

                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucMainRxRecent}" Value="True">
                                                                <Setter Property="Fill" Value="#10B981" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="RX" Style="{StaticResource RibbonChipMutedTextStyle}" Margin="0,0,8,0" />

                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucMainTimeoutActive}" Value="True">
                                                                <Setter Property="Fill" Value="#EF4444" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="TO" Style="{StaticResource RibbonChipMutedTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipInfoBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#EF4444" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucMainPortOpen}" Value="True">
                                                                <Setter Property="Fill" Value="#22C55E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding NucMainPortStateText, StringFormat=PORT {0}}" Style="{StaticResource RibbonChipTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipInfoBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#64748B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NucMainCommStateText}" Value="RESPONSIVE">
                                                                <Setter Property="Fill" Value="#22C55E" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NucMainCommStateText}" Value="RECOVERING">
                                                                <Setter Property="Fill" Value="#F59E0B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NucMainCommStateText}" Value="TIMEOUT">
                                                                <Setter Property="Fill" Value="#EF4444" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NucMainCommStateText}" Value="NO RESPONSE">
                                                                <Setter Property="Fill" Value="#94A3B8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding NucMainCommStateText, StringFormat=COMM {0}}" Style="{StaticResource RibbonChipTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipBorderStyle}">
                                        <TextBlock Text="{Binding RedundancyPrimaryPort}" Style="{StaticResource RibbonChipTextStyle}" />
                                    </Border>


                                    <Border Style="{StaticResource RibbonChipFaultBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRedundancyMainFaultActive}" Value="True">
                                                                <Setter Property="Fill" Value="#EF4444" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="L1FT" Style="{StaticResource RibbonChipTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucMainGiRecent}" Value="True">
                                                                <Setter Property="Fill" Value="#FBBF24" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="GI" Style="{StaticResource RibbonChipMutedTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucMainClass1Recent}" Value="True">
                                                                <Setter Property="Fill" Value="#22C55E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="C1" Style="{StaticResource RibbonChipMutedTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucMainClass2Recent}" Value="True">
                                                                <Setter Property="Fill" Value="#38BDF8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="C2" Style="{StaticResource RibbonChipMutedTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipBorderStyle}" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucMainLinkCheckRecent}" Value="True">
                                                                <Setter Property="Fill" Value="#38BDF8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="LNK" Style="{StaticResource RibbonChipMutedTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource RibbonCounterChipBorderStyle}" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding NucLinkAVisual.Rows[2].Value, StringFormat=TX:{0}}"
                   Style="{StaticResource RibbonChipNumericTextStyle}"
                   Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding NucLinkAVisual.Rows[1].Value, StringFormat=RX:{0}}"
                   Style="{StaticResource RibbonChipNumericTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </ScrollViewer>

                    <Canvas x:Name="MainRibbonFlowCanvas"
                            Height="3"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            ClipToBounds="True">
                        <Rectangle Width="{Binding ActualWidth, ElementName=BackupRibbonFlowCanvas}"
                                   Height="3"
                                   x:Name="MainRibbonBaseLine"
                                   Fill="{Binding NucLinkAVisual.StateBrush}"
                                   Opacity="0.22"
                                   RadiusX="1.5"
                                   RadiusY="1.5" />
                        <Rectangle x:Name="MainRibbonFlowLine"
                                   Width="96"
                                   Height="3"
                                   RadiusX="1.5"
                                   RadiusY="1.5"
                                   Opacity="0.95"
                                   Fill="{Binding NucLinkAVisual.StateBrush}">
                            <Rectangle.RenderTransform>
                                <TranslateTransform X="-1200" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                </Grid>

            </Border>


            <Border Grid.Row="2"
        Padding="12,8"
        Background="#0F1A2A"
        BorderThickness="1,1,1,3"
        CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#22314A" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NucLinkBVisual.StateText}" Value="Active">
                                <Setter Property="BorderBrush" Value="#22C55E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkBVisual.StateText}" Value="Standby">
                                <Setter Property="BorderBrush" Value="#38BDF8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkBVisual.StateText}" Value="Fault">
                                <Setter Property="BorderBrush" Value="#EF4444" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkBVisual.StateText}" Value="Offline">
                                <Setter Property="BorderBrush" Value="#EF4444" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkBVisual.StateText}" Value="Disconnected">
                                <Setter Property="BorderBrush" Value="#EF4444" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid ClipToBounds="True">
                    <!-- isi ribbon lama -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="BackupLinkNameChip" Style="{StaticResource RibbonChipBorderStyle}">
                                        <TextBlock Text="LINK B" Style="{StaticResource RibbonChipTextStyle}" FontWeight="Bold" />
                                    </Border>

                                    <Border x:Name="BackupStateChip" Style="{StaticResource RibbonChipAccentBorderStyle}"
        Width="90">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                 Width="8"
                 Height="8"
                 Margin="0,0,4,0"
                 VerticalAlignment="Center"
                 Fill="{Binding NucLinkBVisual.StateBrush}" />

                                            <TextBlock Grid.Column="1"
                   Text="{Binding NucLinkBVisual.StateText}"
                   Style="{StaticResource RibbonChipTextStyle}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucBackupTxRecent}" Value="True">
                                                                <Setter Property="Fill" Value="#F59E0B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="TX" Style="{StaticResource RibbonChipMutedTextStyle}" Margin="0,0,8,0" />

                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucBackupRxRecent}" Value="True">
                                                                <Setter Property="Fill" Value="#10B981" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="RX" Style="{StaticResource RibbonChipMutedTextStyle}" Margin="0,0,8,0" />

                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucBackupTimeoutActive}" Value="True">
                                                                <Setter Property="Fill" Value="#EF4444" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="TO" Style="{StaticResource RibbonChipMutedTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipInfoBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#EF4444" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucBackupPortOpen}" Value="True">
                                                                <Setter Property="Fill" Value="#22C55E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding NucBackupPortStateText, StringFormat=PORT {0}}" Style="{StaticResource RibbonChipTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipInfoBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#64748B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NucBackupCommStateText}" Value="RESPONSIVE">
                                                                <Setter Property="Fill" Value="#22C55E" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NucBackupCommStateText}" Value="RECOVERING">
                                                                <Setter Property="Fill" Value="#F59E0B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NucBackupCommStateText}" Value="TIMEOUT">
                                                                <Setter Property="Fill" Value="#EF4444" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NucBackupCommStateText}" Value="NO RESPONSE">
                                                                <Setter Property="Fill" Value="#94A3B8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding NucBackupCommStateText, StringFormat=COMM {0}}" Style="{StaticResource RibbonChipTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipBorderStyle}">
                                        <TextBlock Text="{Binding RedundancyBackupPort}" Style="{StaticResource RibbonChipTextStyle}" />
                                    </Border>


                                    <Border Style="{StaticResource RibbonChipFaultBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRedundancyBackupFaultActive}" Value="True">
                                                                <Setter Property="Fill" Value="#EF4444" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="L2FT" Style="{StaticResource RibbonChipTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucBackupGiRecent}" Value="True">
                                                                <Setter Property="Fill" Value="#FBBF24" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="GI" Style="{StaticResource RibbonChipMutedTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucBackupClass1Recent}" Value="True">
                                                                <Setter Property="Fill" Value="#22C55E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="C1" Style="{StaticResource RibbonChipMutedTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucBackupClass2Recent}" Value="True">
                                                                <Setter Property="Fill" Value="#38BDF8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="C2" Style="{StaticResource RibbonChipMutedTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RibbonChipBorderStyle}" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNucBackupLinkCheckRecent}" Value="True">
                                                                <Setter Property="Fill" Value="#38BDF8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="LNK" Style="{StaticResource RibbonChipMutedTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource RibbonCounterChipBorderStyle}" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding NucLinkBVisual.Rows[2].Value, StringFormat=TX:{0}}"
                   Style="{StaticResource RibbonChipNumericTextStyle}"
                   Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding NucLinkBVisual.Rows[1].Value, StringFormat=RX:{0}}"
                   Style="{StaticResource RibbonChipNumericTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </ScrollViewer>

                    <Canvas x:Name="BackupRibbonFlowCanvas"
                            Height="3"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            ClipToBounds="True">
                        <Rectangle Width="{Binding ActualWidth, ElementName=BackupRibbonFlowCanvas}"
                                   Height="3"
                                   x:Name="BackupRibbonBaseLine"
                                   Fill="{Binding NucLinkBVisual.StateBrush}"
                                   Opacity="0.22"
                                   RadiusX="1.5"
                                   RadiusY="1.5" />
                        <Rectangle x:Name="BackupRibbonFlowLine"
                                   Width="96"
                                   Height="3"
                                   RadiusX="1.5"
                                   RadiusY="1.5"
                                   Opacity="0.95"
                                   Fill="{Binding NucLinkBVisual.StateBrush}">
                            <Rectangle.RenderTransform>
                                <TranslateTransform X="-1200" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                </Grid>

            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.45*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="0.55*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Value Viewer" Style="{StaticResource SectionTitleStyle}" />
                    <DataGrid Grid.Row="1"
                              x:Name="NucValueViewerGrid"
                              Margin="0,12,0,0"
                              ItemsSource="{Binding NucValues}"
                              SelectedItem="{Binding SelectedNucValue}"
                              MouseDoubleClick="NucValueViewer_MouseDoubleClick"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              ClipboardCopyMode="IncludeHeader"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              AlternatingRowBackground="{StaticResource NucCardBrush}"
                              Background="{StaticResource NucInnerBrush}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No" Binding="{Binding No}" Width="60" />
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="170" />
                            <DataGridTextColumn Header="Signal Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="IOA" Binding="{Binding IOA}" Width="90" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#22314A"
                          ShowsPreview="True" />

            <Border Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="NUC Event Log" Style="{StaticResource SectionTitleStyle}" />
                    <DataGrid Grid.Row="1"
                              Margin="0,12,0,0"
                              ItemsSource="{Binding NucEventLog}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="False"
                              SelectionMode="Extended"
                              SelectionUnit="CellOrRowHeader"
                              ClipboardCopyMode="IncludeHeader"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              AlternatingRowBackground="{StaticResource NucCardBrush}"
                              Background="{StaticResource NucInnerBrush}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="170" />
                            <DataGridTextColumn Header="Channel" Binding="{Binding Source}" Width="90" />
                            <DataGridTextColumn Header="Signal Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="IOA" Binding="{Binding IOA}" Width="90" />
                            <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="140" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter x:Name="LineMonitorDockSplitter"
                      Grid.Row="3"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#22314A"
                      ShowsPreview="True"
                      DragCompleted="LineMonitorDockSplitter_DragCompleted" />

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="LineMonitorDockBorder"
                    Grid.Row="0"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="NUC Line Monitor"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="OpenLinkTraceButton"
                                    Width="108"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="OpenLinkTrace_Click"
                                    ToolTip="Open Link Trace">
                                <TextBlock Text="Link Trace"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="#E2E8F0"
                                           HorizontalAlignment="Center" />
                            </Button>
                            <Button x:Name="LineMonitorDockToggleButton"
                                    Style="{StaticResource LineMonitorToggleButtonStyle}"
                                    Click="ToggleLineMonitorPane_Click"
                                    ToolTip="Collapse line monitor">
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="LineMonitorContentGrid"
                              Grid.Row="1"
                              Margin="0,12,0,0"
                              ItemsSource="{Binding NucLineMonitor}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Style="{StaticResource LineMonitorGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="120" />
                            <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="60" />
                            <DataGridTextColumn Header="Frame" Binding="{Binding FrameType}" Width="80" />
                            <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
