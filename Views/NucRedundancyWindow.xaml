<Window x:Class="IEC101MasterTester.Views.NucRedundancyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IEC 60870-5-101 Dual Link Redundancy Test"
        Height="920"
        Width="1480"
        MinHeight="760"
        MinWidth="1220"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0B1220"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <SolidColorBrush x:Key="NucCardBrush" Color="#111A2B" />
            <SolidColorBrush x:Key="NucCardStrongBrush" Color="#162338" />
            <SolidColorBrush x:Key="NucInnerBrush" Color="#0E1625" />
            <SolidColorBrush x:Key="NucStrokeBrush" Color="#22314A" />
            <SolidColorBrush x:Key="NucTextBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="NucMutedBrush" Color="#94A3B8" />

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource NucCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NucStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource NucTextBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="RibbonChipBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#132033" />
                <Setter Property="BorderBrush" Value="#22314A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <Style x:Key="RibbonChipAccentBorderStyle" TargetType="Border" BasedOn="{StaticResource RibbonChipBorderStyle}">
                <Setter Property="Background" Value="#10251F" />
                <Setter Property="BorderBrush" Value="#1F7A4D" />
            </Style>

            <Style x:Key="RibbonChipInfoBorderStyle" TargetType="Border" BasedOn="{StaticResource RibbonChipBorderStyle}">
                <Setter Property="Background" Value="#102132" />
                <Setter Property="BorderBrush" Value="#24577A" />
            </Style>

            <Style x:Key="RibbonChipFaultBorderStyle" TargetType="Border" BasedOn="{StaticResource RibbonChipBorderStyle}">
                <Setter Property="Background" Value="#2A1518" />
                <Setter Property="BorderBrush" Value="#7F1D1D" />
            </Style>

            <Style x:Key="RibbonChipTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource NucTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="RibbonChipNumericTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RibbonChipTextStyle}">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <Style x:Key="RibbonCounterChipBorderStyle" TargetType="Border" BasedOn="{StaticResource RibbonChipBorderStyle}">
                <Setter Property="MinWidth" Value="128" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <Style x:Key="RibbonChipMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource NucMutedBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
                <Setter Property="Foreground" Value="#CFE5FF" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#60A5FA" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Foreground" Value="#38BDF8" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#64748B" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ActionPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                <Setter Property="Foreground" Value="#F8FAFC" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Foreground" Value="#DBEAFE" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#94A3B8" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ActionDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerActionButtonStyle}">
                <Setter Property="Foreground" Value="#FEE2E2" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#FCA5A5" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Foreground" Value="#F87171" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#7F1D1D" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ActionButtonLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <Style x:Key="ActionIconPathStyle" TargetType="Path">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <Setter Property="StrokeThickness" Value="1.8" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#60A5FA"
                              BlurRadius="6"
                              ShadowDepth="0"
                              Opacity="0.45" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActionDangerIconPathStyle" TargetType="Path" BasedOn="{StaticResource ActionIconPathStyle}">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#EF4444"
                              BlurRadius="6"
                              ShadowDepth="0"
                              Opacity="0.35" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActionGaugePathStyle" TargetType="Path">
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#60A5FA"
                              BlurRadius="6"
                              ShadowDepth="0"
                              Opacity="0.55" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ActionPrimaryIconPathStyle" TargetType="Path" BasedOn="{StaticResource ActionIconPathStyle}">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#93C5FD"
                              BlurRadius="7"
                              ShadowDepth="0"
                              Opacity="0.65" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RoundIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource NucTextBrush}" />
                <Setter Property="Background" Value="#162338" />
                <Setter Property="BorderBrush" Value="#314255" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Circle"
                                         Fill="{TemplateBinding Background}"
                                         Stroke="{TemplateBinding BorderBrush}"
                                         StrokeThickness="{TemplateBinding BorderThickness}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="1"
                                                          BlurRadius="4"
                                                          Opacity="0.25" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Circle" Property="Fill" Value="#20314C" />
                                    <Setter TargetName="Circle" Property="Stroke" Value="#4E86BA" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Circle" Property="Fill" Value="#0F1B2C" />
                                    <Setter TargetName="Circle" Property="Stroke" Value="#60A5FA" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LineMonitorToggleButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#132033" />
                <Setter Property="BorderBrush" Value="#334155" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15">
                                <Grid>
                                    <Path x:Name="Chevron"
                                          Width="10"
                                          Height="10"
                                          Stroke="#E2E8F0"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M 2 4 L 5 7 L 8 4"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="LineMonitorDockChevronRotate" Angle="0" CenterX="5" CenterY="5" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <Ellipse Width="4"
                                             Height="4"
                                             Fill="#38BDF8"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="0,5,5,0"
                                             Opacity="0.0" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#38BDF8" />
                                    <Setter TargetName="Root" Property="Background" Value="#16263A" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#0F1A2A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LineMonitorGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource NucInnerBrush}" />
                <Setter Property="Foreground" Value="{StaticResource NucTextBrush}" />
                <Setter Property="BorderBrush" Value="#22314A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{StaticResource NucInnerBrush}" />
                <Setter Property="AlternatingRowBackground" Value="#101A2B" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource NucTextBrush}" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#16263A" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1D4E89" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource NucTextBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#16263A" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1D4E89" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="ZoomRootHost" Margin="14" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="WindowZoomTransform" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition x:Name="LineMonitorDockRow" Height="230" MinHeight="76" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Background="{StaticResource NucCardStrongBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="IEC 60870-5-101 Dual-link Redundancy Analyzer" TextWrapping="Wrap"
                               FontSize="18"
                               Foreground="{StaticResource NucTextBrush}" FontWeight="Bold" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource NucMutedBrush}"
                               Text="{Binding RedundancyConfigSummaryText}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,0">

                    <WrapPanel HorizontalAlignment="Right">

                        <Button Width="108"
            Margin="0,0,6,0"
            Style="{StaticResource ActionButtonStyle}"
            Click="ConfigureLinks_Click"
            ToolTip="Configure Links">
                            <StackPanel Orientation="Vertical">
                                <Path Style="{StaticResource ActionIconPathStyle}"
                  Data="M12 2 L20 6.5 L20 17.5 L12 22 L4 17.5 L4 6.5 Z M9 12 H15 M12 9 V15"/>
                                <TextBlock Text="Configure"
                       Style="{StaticResource ActionButtonLabelStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Width="108"
        Margin="0,0,6,0"
        IsEnabled="{Binding CanStartNucRedundancySessionButton}"
        Click="StartSession_Click"
        ToolTip="Start Session"
        RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Button.RenderTransform>

                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionPrimaryButtonStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Vertical">
                                <Path Style="{StaticResource ActionPrimaryIconPathStyle}"
      Data="M12 17 V21 M8 21 H16 M15 9.5 L10.5 12.2 V6.8 L15 9.5 M4 3 H20 A2 2 0 0 1 22 5 V15 A2 2 0 0 1 20 17 H4 A2 2 0 0 1 2 15 V5 A2 2 0 0 1 4 3 Z"/>
                                <TextBlock Text="Start Session"
                       Style="{StaticResource ActionButtonLabelStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Width="108"
            Margin="0,0,6,0"
            Style="{StaticResource ActionDangerButtonStyle}"
            IsEnabled="{Binding CanStopNucRedundancySessionButton}"
            Click="StopSession_Click"
            ToolTip="Stop Session">
                            <StackPanel Orientation="Vertical">
                                <Path Style="{StaticResource ActionDangerIconPathStyle}"
                  Data="M14.5 12.5 L9.5 7.5 M9.5 12.5 L14.5 7.5 M12 17 V21 M8 21 H16 M4 3 H20 A2 2 0 0 1 22 5 V15 A2 2 0 0 1 20 17 H4 A2 2 0 0 1 2 15 V5 A2 2 0 0 1 4 3 Z"/>
                                <TextBlock Text="Stop Session"
                       Style="{StaticResource ActionButtonLabelStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Width="94"
            Margin="0,0,6,0"
            Style="{StaticResource ActionButtonStyle}"
            IsEnabled="{Binding CanStopNucRedundancySessionButton}"
            Click="SendGi_Click"
            ToolTip="Send General Interrogation">
                            <StackPanel Orientation="Vertical">
                                <Path Style="{StaticResource ActionIconPathStyle}"
                  Data="M6 4 H18 M6 9 H18 M6 14 H12 M14 18 L17 21 L22 15"/>
                                <TextBlock Text="Send GI"
                       Style="{StaticResource ActionButtonLabelStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Width="94"
            Margin="0,0,6,0"
            Style="{StaticResource ActionButtonStyle}"
            Click="OpenAvailabilityDashboard_Click"
            ToolTip="Open Availability Dashboard">
                            <StackPanel Orientation="Vertical">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource ActionGaugePathStyle}"
                          Data="M12 14 L16 10"/>
                                        <Path Style="{StaticResource ActionGaugePathStyle}"
                          Data="M3.34 19 A10 10 0 1 1 20.66 19"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Availability"
                       Style="{StaticResource ActionButtonLabelStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Width="94"
            Margin="0,0,6,0"
            Style="{StaticResource ActionDangerButtonStyle}"
            Click="ClearBufferEventStatistic_Click"
            ToolTip="Clear Buffer, Event, and Statistic">
                            <StackPanel Orientation="Vertical">
                                <Path Style="{StaticResource ActionDangerIconPathStyle}"
                  Data="M5 7 H19 M9 7 V5 H15 V7 M8 10 V17 M12 10 V17 M16 10 V17 M7 7 L8 20 H16 L17 7"/>
                                <TextBlock Text="Clear Runtime"
                       Style="{StaticResource ActionButtonLabelStyle}" />
                            </StackPanel>
                        </Button>


                        <Button Width="90"
            Margin="0,0,6,0"
            Style="{StaticResource ActionButtonStyle}"
            Click="OpenLinkTrace_Click"
            ToolTip="Open Link Trace">
                            <StackPanel Orientation="Vertical">
                                <Path Style="{StaticResource ActionIconPathStyle}"
                  Data="M3 16 H7 L9 9 L12 14 L15 6 L18 12 H21 M4 4 H20 V20 H4 Z"/>
                                <TextBlock Text="Link Trace"
                       Style="{StaticResource ActionButtonLabelStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Width="90"
            Style="{StaticResource ActionButtonStyle}"
            Click="OpenSoeAudit_Click"
            ToolTip="Open SOE Audit">
                            <StackPanel Orientation="Vertical">
                                <Path Style="{StaticResource ActionIconPathStyle}"
                  Data="M7 4 H17 M7 8 H17 M7 12 H13 M5 3 H19 V21 H5 Z"/>
                                <TextBlock Text="SOE Audit"
                       Style="{StaticResource ActionButtonLabelStyle}" />
                            </StackPanel>
                        </Button>

                        <Button Width="98"
        Margin="0,0,6,0"
        Style="{StaticResource ActionButtonStyle}"
        Click="OpenMainWindow_Click"
        ToolTip="Open Single Link Test Window">

                            <StackPanel Orientation="Vertical">

                                <Path Style="{StaticResource ActionIconPathStyle}"
              Data="M15 3H21V9 M10 14L21 3 M18 13V19A2 2 0 0 1 16 21H5A2 2 0 0 1 3 19V8A2 2 0 0 1 5 6H11"/>

                                <TextBlock Text="Single Link"
                   Style="{StaticResource ActionButtonLabelStyle}" />

                            </StackPanel>
                        </Button>


                        <Button Width="40"
                            Height="40"
                            Margin="0,5,0,8"
                            Click="About_Click"
                            ToolTip="About"
                            HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                            Style="{StaticResource RoundIconButtonStyle}">
                            <TextBlock Text="?"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Button>


                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
        Padding="12,8"
        Background="#0F1A2A"
        BorderThickness="1,1,1,3"
        CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#22314A" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NucLinkAVisual.HealthText}" Value="Responsive">
                                <Setter Property="BorderBrush" Value="#22C55E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkAVisual.RoleText}" Value="Standby">
                                <Setter Property="BorderBrush" Value="#38BDF8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkAVisual.HealthText}" Value="Fault">
                                <Setter Property="BorderBrush" Value="#EF4444" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkAVisual.HealthText}" Value="Timeout">
                                <Setter Property="BorderBrush" Value="#EF4444" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkAVisual.HealthText}" Value="No Response">
                                <Setter Property="BorderBrush" Value="#EF4444" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkAVisual.HealthText}" Value="Recovering">
                                <Setter Property="BorderBrush" Value="#F59E0B" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NucLinkAVisual.HealthText}" Value="Switching">
                                <Setter Property="BorderBrush" Value="#F59E0B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid ClipToBounds="True">
                    <!-- isi ribbon lama -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="MainLinkNameChip" Style="{StaticResource RibbonChipBorderStyle}">
                                        <TextBlock Text="LINK A" Style="{StaticResource RibbonChipTextStyle}" FontWeight="Bold" />
                                    </Border>

                                    <Border x:Name="MainStateChip" Style="{StaticResource RibbonChipAccentBorderStyle}"
        Width="90">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                 Width="8"
                 Height="8"
                 Margin="0,0,4,0"
                 VerticalAlignment="Center"
                 Fill="{Binding NucLinkAVisual.StateBrush}" />

                                            <TextBlock Grid.Column="1"
                   Text="{Binding NucLinkAVisual.StateText}"
                   Style="{StaticResource RibbonChipTextStyle}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource RibbonChipBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,5,4,0">
                                                <Ellipse.Style>
