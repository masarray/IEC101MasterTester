<Window x:Class="IEC101MasterTester.Views.BufferedEventAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IEC-101 Buffer / SOE Audit"
        Height="620"
        Width="1120"
        MinHeight="420"
        MinWidth="860"
        WindowStartupLocation="Manual"
        Background="#0F172A">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10" Background="#0F172A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Buffer / SOE Audit"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#94A3B8"
                               Text="Disconnect, generate events, reconnect, then review replay evidence and verdict." />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Foreground="#CBD5E1"
                               FontWeight="SemiBold"
                               Text="{Binding BufferReplayStatusText}" />
                    <TextBlock Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="#94A3B8"
                               Text="{Binding BufferReplaySummaryText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,10,0,10"
                Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <UniformGrid Columns="5">
                <StackPanel Margin="6,0">
                    <TextBlock Foreground="#94A3B8" Text="Latest Replay" />
                    <TextBlock Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold"
                               Text="{Binding BufferReplaySessions[0].ReplayEventCount, FallbackValue=0}" />
                </StackPanel>
                <StackPanel Margin="6,0">
                    <TextBlock Foreground="#94A3B8" Text="Duplicates" />
                    <TextBlock Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold"
                               Text="{Binding BufferReplaySessions[0].DuplicateEventCount, FallbackValue=0}" />
                </StackPanel>
                <StackPanel Margin="6,0">
                    <TextBlock Foreground="#94A3B8" Text="FIFO Violations" />
                    <TextBlock Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold"
                               Text="{Binding BufferReplaySessions[0].FifoViolationCount, FallbackValue=0}" />
                </StackPanel>
                <StackPanel Margin="6,0">
                    <TextBlock Foreground="#94A3B8" Text="Sample Size" />
                    <TextBlock Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold"
                               Text="{Binding BufferReplaySessions[0].SampleCheckCount, FallbackValue=0}" />
                </StackPanel>
                <StackPanel Margin="6,0">
                    <TextBlock Foreground="#94A3B8" Text="600 Event Rule" />
                    <TextBlock Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold"
                               Text="{Binding BufferReplaySessions[0].FinalVerdict, FallbackValue=Not evaluated}" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <Border Grid.Row="2" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="8">
            <DataGrid ItemsSource="{Binding BufferReplaySessions}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      Background="#111827"
                      Foreground="#F8FAFC"
                      BorderBrush="#334155"
                      HorizontalGridLinesBrush="#1F2937"
                      VerticalGridLinesBrush="#1F2937"
                      RowBackground="#111827"
                      AlternatingRowBackground="#0F172A">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#17202B" />
                        <Setter Property="Foreground" Value="#CBD5E1" />
                        <Setter Property="BorderBrush" Value="#334155" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="#1F2937" />
                        <Setter Property="Foreground" Value="#E2E8F0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Disconnected" Binding="{Binding DisconnectedAtText}" Width="150" />
                    <DataGridTextColumn Header="Reconnected" Binding="{Binding ReconnectedAtText}" Width="150" />
                    <DataGridTextColumn Header="Buffered" Binding="{Binding BufferedEventCount}" Width="70" />
                    <DataGridTextColumn Header="Replay" Binding="{Binding ReplayEventCount}" Width="70" />
                    <DataGridTextColumn Header="Missing" Binding="{Binding MissingEventCount}" Width="70" />
                    <DataGridTextColumn Header="Duplicate" Binding="{Binding DuplicateEventCount}" Width="75" />
                    <DataGridTextColumn Header="FIFO" Binding="{Binding FifoViolationCount}" Width="60" />
                    <DataGridTextColumn Header="Sample 7%" Binding="{Binding SampleCheckCount}" Width="85" />
                    <DataGridTextColumn Header="Sample Ts" Binding="{Binding SampleTimestampViolationCount}" Width="80" />
                    <DataGridCheckBoxColumn Header=">= 600" Binding="{Binding MeetsMinimum600Events}" Width="60" />
                    <DataGridTextColumn Header="Verdict" Binding="{Binding FinalVerdict}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
