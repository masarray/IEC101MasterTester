<Window x:Class="IEC101MasterTester.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About IEC101MasterTester"
        Width="460"
        Height="320"
        MinWidth="420"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="14" Background="#17202B" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="IEC101MasterTester" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Margin="0,6,0,0" Foreground="#D8E2EE" Text="IEC-60870-5-101 Master Tester for practical FAT and troubleshooting." TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,14,0,14" Padding="14" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Communication principles" />
                <TextBlock Margin="0,8,0,0" Foreground="#334155" TextWrapping="Wrap" Text="IEC-101 communication now uses the project-owned native clean-room stack. Event Log is operator-facing SCADA journaling. Line Monitor remains the technical wire trace." />
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Foreground="#0F172A" Text="Focus" />
                <TextBlock Margin="0,8,0,0" Foreground="#334155" TextWrapping="Wrap" Text="Protocol correctness first, then stable operator workflow, then observability and UI polish." />
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Width="90"
                Height="34"
                HorizontalAlignment="Right"
                Content="Close"
                IsDefault="True"
                Click="Close_Click" />
    </Grid>
</Window>
