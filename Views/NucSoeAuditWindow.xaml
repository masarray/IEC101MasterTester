<Window x:Class="IEC101MasterTester.Views.NucSoeAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IEC-101 NUC SOE Audit"
        Height="720"
        Width="1280"
        MinHeight="520"
        MinWidth="960"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SoeToolbarCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="Foreground" Value="#E2E8F0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12" Background="#0F172A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="NUC SOE Audit"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#94A3B8"
                               Text="Detailed NUC event audit for switchover, buffer replay, and channel continuity verification." />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Foreground="#CBD5E1"
                               FontWeight="SemiBold"
                               Text="{Binding RedundancyActiveLinkText}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#94A3B8"
                               Text="{Binding RedundancyGiObservationText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,10,0,10"
                Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">
            <UniformGrid Columns="4">
                <StackPanel Margin="6,0">
                    <TextBlock Foreground="#94A3B8" Text="Switchover Count" />
                    <TextBlock Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" Text="{Binding RedundancySwitchSummaryText}" />
                </StackPanel>
                <StackPanel Margin="6,0">
                    <TextBlock Foreground="#94A3B8" Text="Continuity" />
                    <TextBlock Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" Text="{Binding RedundancyContinuityText}" />
                </StackPanel>
                <StackPanel Margin="6,0">
                    <TextBlock Foreground="#94A3B8" Text="L1FT" />
                    <TextBlock Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" Text="{Binding RedundancyMainLinkText}" />
                </StackPanel>
                <StackPanel Margin="6,0">
                    <TextBlock Foreground="#94A3B8" Text="L2FT" />
                    <TextBlock Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" Text="{Binding RedundancyBackupLinkText}" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,10"
                Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryActionButtonStyle}"
        Click="ClearFilters_Click"
        Margin="0,0,8,0"
        ToolTip="Clear all filters">
                        <StackPanel>
                            <Grid Width="18" Height="18" HorizontalAlignment="Center">
                                <!-- Funnel -->
                                <Path Stroke="#E2E8F0"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Data="M3 4H15L10 10V14L8 15V10L3 4" />

                                <!-- X mark -->
                                <Path Stroke="#E2E8F0"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="M11.8 11.8L15.8 15.8M15.8 11.8L11.8 15.8" />
                            </Grid>

                            <TextBlock Text="Clear Filter"
                   Style="{StaticResource SoeToolbarCaptionTextStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryActionButtonStyle}"
                            Click="ExportExcel_Click"
                            Margin="0,0,8,0"
                            ToolTip="Export filtered rows to Excel">
                        <StackPanel>
                            <Path Width="18" Height="18" Stretch="Uniform" Stroke="#F8FAFC" StrokeThickness="1.8" Data="M14 3H6a2 2 0 0 0-2 2v14l4-3 4 3 4-3 4 3V9zM8 7h8M8 11h6" HorizontalAlignment="Center"/>
                            <TextBlock Text="Export Excel" Style="{StaticResource SoeToolbarCaptionTextStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryActionButtonStyle}"
                            IsEnabled="False"
                            ToolTip="PDF export planned for phase 2">
                        <StackPanel>
                            <Path Width="18" Height="18" Stretch="Uniform" Stroke="#CBD5E1" StrokeThickness="1.8" Data="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm7 0v5h5M9 13h6M9 17h6" HorizontalAlignment="Center"/>
                            <TextBlock Text="Export PDF" Style="{StaticResource SoeToolbarCaptionTextStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Foreground="#94A3B8" Text="IOA" />
                            <TextBox x:Name="IoaFilterTextBox" Width="90" Style="{StaticResource DarkPopupTextBoxStyle}" TextChanged="FilterControl_Changed" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Foreground="#94A3B8" Text="Signal" />
                            <TextBox x:Name="SignalFilterTextBox" Width="150" Style="{StaticResource DarkPopupTextBoxStyle}" TextChanged="FilterControl_Changed" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Foreground="#94A3B8" Text="Channel" />
                            <TextBox x:Name="ChannelFilterTextBox" Width="90" Style="{StaticResource DarkPopupTextBoxStyle}" TextChanged="FilterControl_Changed" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Foreground="#94A3B8" Text="Event" />
                            <TextBox x:Name="EventFilterTextBox" Width="130" Style="{StaticResource DarkPopupTextBoxStyle}" TextChanged="FilterControl_Changed" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Foreground="#94A3B8" Text="Value" />
                            <TextBox x:Name="ValueFilterTextBox" Width="100" Style="{StaticResource DarkPopupTextBoxStyle}" TextChanged="FilterControl_Changed" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Foreground="#94A3B8" Text="From" />
                            <TextBox x:Name="FromFilterTextBox" Width="150" Style="{StaticResource DarkPopupTextBoxStyle}" TextChanged="FilterControl_Changed" ToolTip="yyyy-MM-dd HH:mm:ss" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Foreground="#94A3B8" Text="To" />
                            <TextBox x:Name="ToFilterTextBox" Width="150" Style="{StaticResource DarkPopupTextBoxStyle}" TextChanged="FilterControl_Changed" ToolTip="yyyy-MM-dd HH:mm:ss" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Foreground="#94A3B8" Text="Search" />
                            <TextBox x:Name="SearchFilterTextBox" Width="180" Style="{StaticResource DarkPopupTextBoxStyle}" TextChanged="FilterControl_Changed" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="FilterSummaryTextBlock"
                           Margin="4,0,0,8"
                           Foreground="#94A3B8"
                           Text="Showing all rows." />
                <DataGrid x:Name="AuditGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding NucSoeAuditLog}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      Background="#111827"
                      Foreground="#F8FAFC"
                      BorderBrush="#334155"
                      HorizontalGridLinesBrush="#1F2937"
                      VerticalGridLinesBrush="#1F2937"
                      RowBackground="#111827"
                      AlternatingRowBackground="#0F172A"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#17202B" />
                        <Setter Property="Foreground" Value="#CBD5E1" />
                        <Setter Property="BorderBrush" Value="#334155" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="#1F2937" />
                        <Setter Property="Foreground" Value="#E2E8F0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Recv Time" Binding="{Binding Time}" Width="175" />
                    <DataGridTextColumn Header="Channel" Binding="{Binding Source}" Width="90" />
                    <DataGridTextColumn Header="Signal Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="IOA" Binding="{Binding IOA}" Width="90" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" />
                    <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="170" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="150" />
                    <DataGridTextColumn Header="COT" Binding="{Binding Cot}" Width="110" />
                </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
