<Window x:Class="IEC101MasterTester.Views.SignalCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signal Command"
        Width="780"
        Height="361"
        MinWidth="760"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SignalDangerHoverButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                <Setter Property="Background" Value="{StaticResource HeaderAltBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PopupBorderBrush}"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.22"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="4"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#DC2626"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#DC2626"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#B91C1C"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#B91C1C"/>
                                    <Setter TargetName="BtnBorder" Property="Effect" Value="{x:Null}"/>
                                    <Setter TargetName="BtnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SignalDangerPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#DC2626"/>
                <Setter Property="BorderBrush" Value="#DC2626"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.22"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="4"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#EF4444"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#EF4444"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#B91C1C"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#B91C1C"/>
                                    <Setter TargetName="BtnBorder" Property="Effect" Value="{x:Null}"/>
                                    <Setter TargetName="BtnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="SectionHeaderCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#0F172A"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#0F172A">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <Border Grid.Column="0"
                    Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Signal Info -->
                    <Border Grid.Row="0"
                            Style="{StaticResource SectionHeaderCardStyle}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC"
                                       Text="Command Actions" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource DarkPopupTextBlockStyle}"
                                       Text="{Binding SignalName}" />
                            <TextBlock Foreground="#94A3B8"
                                       Text="{Binding SignalInfo}" />
                        </StackPanel>
                    </Border>

                    <!-- Command IOA -->
                    <Border Grid.Row="2"
                            Background="#0F172A"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource DarkPopupTextBlockStyle}"
                                       Text="Command IOA" />

                            <TextBox Grid.Column="1"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DarkPopupTextBoxStyle}"
                                     Text="{Binding CommandIoa, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <!-- Command Action Panel -->
                    <Border Grid.Row="4"
                            Background="#0F172A"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#F8FAFC"
                                           Text="Command Actions" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="#14B8A6"
                                           Text="Select Before Operate" />
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0"
                                        Grid.Column="0"
                                        Height="36"
                                        Style="{StaticResource TactileSecondaryButtonStyle}"
                                        Content="{Binding SelectPrimaryLabel}"
                                        Click="SelectPrimary_Click" />

                                <Button Grid.Row="0"
                                        Grid.Column="2"
                                        Height="36"
                                        Style="{StaticResource SignalDangerHoverButtonStyle}"
                                        Content="{Binding SelectSecondaryLabel}"
                                        Click="SelectSecondary_Click" />

                                <Button Grid.Row="2"
                                        Grid.Column="0"
                                        Height="36"
                                        Style="{StaticResource TactilePrimaryButtonStyle}"
                                        Content="{Binding ExecPrimaryLabel}"
                                        Click="ExecPrimary_Click" />

                                <Button Grid.Row="2"
                                        Grid.Column="2"
                                        Height="36"
                                        Style="{StaticResource SignalDangerPrimaryButtonStyle}"
                                        Content="{Binding ExecSecondaryLabel}"
                                        Click="ExecSecondary_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL -->
            <Border Grid.Column="2"
                    Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource SectionHeaderCardStyle}">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   Text="Command Response Monitor" />
                    </Border>

                    <DataGrid Grid.Row="1"
                              MaxHeight="290"
                              ItemsSource="{Binding CommandLifeMonitor}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              RowHeight="24"
                              ColumnHeaderHeight="26"
                              FontSize="10.5"
                              GridLinesVisibility="Horizontal"
                              Background="#0F172A"
                              Foreground="#E5EDF7"
                              BorderThickness="1"
                              BorderBrush="#334155"
                              HorizontalGridLinesBrush="#182434"
                              VerticalGridLinesBrush="#182434"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#111827" />
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Setter Property="BorderBrush" Value="#223044" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Padding" Value="6,0,6,0" />
                                <Setter Property="Height" Value="26" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="#E5EDF7" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="#182434" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Padding" Value="6,0,6,0" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>

                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#0F172A" />
                                <Setter Property="Foreground" Value="#E5EDF7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultShort}" Value="TX">
                                        <Setter Property="Background" Value="#102A43" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultShort}" Value="OK">
                                        <Setter Property="Background" Value="#123524" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultShort}" Value="REJ">
                                        <Setter Property="Background" Value="#3F1518" />
                                        <Setter Property="Foreground" Value="#FECACA" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultShort}" Value="TO">
                                        <Setter Property="Background" Value="#453014" />
                                        <Setter Property="Foreground" Value="#FDE68A" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#162033" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1C3357" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="58" />
                            <DataGridTextColumn Header="IOA" Binding="{Binding IoaText}" Width="46" />
                            <DataGridTextColumn Header="Op" Binding="{Binding Operation}" Width="48" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding ModeShort}" Width="64" />

                            <DataGridTemplateColumn Header="Result" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ResultBadge"
                                                Width="40"
                                                Height="18"
                                                CornerRadius="9"
                                                Background="#1E293B"
                                                HorizontalAlignment="Center">
                                            <TextBlock x:Name="ResultBadgeText"
                                                       Text="{Binding ResultShort}"
                                                       Foreground="#E5EDF7"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ResultShort}" Value="TX">
                                                <Setter TargetName="ResultBadge" Property="Background" Value="#1D4ED8" />
                                                <Setter TargetName="ResultBadgeText" Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ResultShort}" Value="OK">
                                                <Setter TargetName="ResultBadge" Property="Background" Value="#059669" />
                                                <Setter TargetName="ResultBadgeText" Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ResultShort}" Value="REJ">
                                                <Setter TargetName="ResultBadge" Property="Background" Value="#DC2626" />
                                                <Setter TargetName="ResultBadgeText" Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ResultShort}" Value="TO">
                                                <Setter TargetName="ResultBadge" Property="Background" Value="#D97706" />
                                                <Setter TargetName="ResultBadgeText" Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="ms" Binding="{Binding LatencyText}" Width="45" />
                            <DataGridTextColumn Header="FB" Binding="{Binding FeedbackText}" Width="74" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
