<Window x:Class="IEC101MasterTester.Views.NucLinkTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IEC101MasterTester.Controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="NUC Link Trace"
        Width="1400"
        Height="820"
        MinWidth="1120"
        MinHeight="680"
        Background="#09111D"
        Foreground="#F3F6FB"
        WindowStartupLocation="CenterOwner"
        SizeChanged="NucLinkTraceWindow_SizeChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#F3F6FB" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8EA3BC" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#6B829D" />
            <SolidColorBrush x:Key="PanelBrush" Color="#101B2A" />
            <SolidColorBrush x:Key="PanelAltBrush" Color="#0D1623" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#243449" />
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
            <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="MetricCaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="11" />
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
            <Style x:Key="ActionButtonStyle" TargetType="{x:Type ButtonBase}">
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="Background" Value="#15263A" />
                <Setter Property="BorderBrush" Value="#2C4560" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="MinWidth" Value="82" />
                <Setter Property="Height" Value="34" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="AnalyzerComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="Background" Value="#132133" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Height" Value="32" />
            </Style>
            <Style x:Key="AnalyzerDataGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="HorizontalGridLinesBrush" Value="#1B2A3B" />
                <Setter Property="VerticalGridLinesBrush" Value="#1B2A3B" />
                <Setter Property="RowBackground" Value="#0F1825" />
                <Setter Property="AlternatingRowBackground" Value="#101B29" />
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NUC Link Trace" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="Industrial moving tape for 60-second live dual-link activity with click-to-inspect."
                               Margin="0,4,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Background="#0E1A28" BorderBrush="#223449" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Read Position" Style="{StaticResource MetricCaptionStyle}" />
                        <TextBlock x:Name="SelectedTimeTextBlock" Text="--:--:--.---" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="Active Link" Style="{StaticResource MetricCaptionStyle}" /><TextBlock Text="{Binding RedundancyActiveLinkText}" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="Link A" Style="{StaticResource MetricCaptionStyle}" /><TextBlock Text="{Binding NucMainCommStateText}" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="Link B" Style="{StaticResource MetricCaptionStyle}" /><TextBlock Text="{Binding NucBackupCommStateText}" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="Last Switchover" Style="{StaticResource MetricCaptionStyle}" /><TextBlock Text="{Binding LastRedundancySwitchText}" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="12,10"><StackPanel><TextBlock Text="Continuity" Style="{StaticResource MetricCaptionStyle}" /><TextBlock Text="{Binding RedundancyContinuityText}" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}" Padding="12,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ToggleButton x:Name="PauseViewButton" Content="Pause" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Click="PauseViewButton_Click" />
                    <Button x:Name="LiveButton" Content="Live" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Click="LiveButton_Click" />
                    <Button x:Name="ClearViewButton" Content="Clear" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Click="ClearViewButton_Click" />
                    <Button x:Name="ExportCsvButton" Content="Export CSV" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Click="ExportCsvButton_Click" />
                    <ToggleButton x:Name="AutoScrollButton" Content="Live Tape" Style="{StaticResource ActionButtonStyle}" IsChecked="True" Click="AutoScrollButton_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Row Limit" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox x:Name="RowLimitComboBox" Width="74" Style="{StaticResource AnalyzerComboBoxStyle}" SelectionChanged="RowLimitComboBox_SelectionChanged">
                        <ComboBoxItem Content="50" IsSelected="True" />
                        <ComboBoxItem Content="100" />
                        <ComboBoxItem Content="200" />
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="92" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Activity Timeline" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Border Background="#112338" BorderBrush="#28445E" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,0"><TextBlock Text="Link A waveform" FontSize="10" Foreground="#8BC6FF" /></Border>
                        <Border Background="#10261B" BorderBrush="#295A3E" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,0"><TextBlock Text="Link B waveform" FontSize="10" Foreground="#7DE5A2" /></Border>
                        <TextBlock Text="Click chart to inspect time" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <Canvas x:Name="TimelineRulerCanvas" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" />
                <controls:NucLinkTraceTapeControl x:Name="TimelineTape" Grid.Row="2" Margin="0,4,0,10" />
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NavigatorStartLabel" Text="--:--:--.---" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="12,0" Text="Fixed 60 s recording tape" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="NavigatorEndLabel" Grid.Column="2" Text="--:--:--.---" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="6">
                        <DataGrid x:Name="LinkAGrid" Style="{StaticResource AnalyzerDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="120" />
                                <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="54" />
                                <DataGridTextColumn Header="Frame" Binding="{Binding FrameType}" Width="78" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="235" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="6">
                        <DataGrid x:Name="LinkBGrid" Style="{StaticResource AnalyzerDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="120" />
                                <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="54" />
                                <DataGridTextColumn Header="Frame" Binding="{Binding FrameType}" Width="78" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="235" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
