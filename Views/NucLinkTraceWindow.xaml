<Window x:Class="IEC101MasterTester.Views.NucLinkTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="NUC Link Trace"
        Width="1400"
        Height="820"
        MinWidth="1120"
        MinHeight="680"
        Background="#0B1220"
        Foreground="#F8FAFC"
        WindowStartupLocation="CenterOwner"
        SizeChanged="NucLinkTraceWindow_SizeChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1220" />
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="NucCardBrush" Color="#111A2B" />
            <SolidColorBrush x:Key="NucInnerBrush" Color="#0E1625" />
            <SolidColorBrush x:Key="NucStrokeBrush" Color="#22314A" />

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource NucCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NucStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="{x:Type ButtonBase}">
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="Background" Value="#17304F" />
                <Setter Property="BorderBrush" Value="#2A4C78" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="MinWidth" Value="84" />
                <Setter Property="Height" Value="36" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ButtonBase}">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#1E436E" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3B82F6" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#123151" />
                                </Trigger>
                                <Trigger Property="ToggleButton.IsChecked" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#1E436E" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3B82F6" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Padding="16">
            <StackPanel>
                <TextBlock Text="NUC Link Trace"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="ASE2000-style capture, timeline scrub, and dual link comparison."
                           Margin="0,6,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Active Link" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding RedundancyActiveLinkText}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Link A" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding NucMainCommStateText}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Link B" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding NucBackupCommStateText}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Margin="0,0,8,0" Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Last Switchover" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding LastRedundancySwitchText}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Continuity" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding RedundancyContinuityText}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}" Padding="12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ToggleButton x:Name="PauseViewButton"
                                  Content="Pause"
                                  Margin="0,0,8,0"
                                  Style="{StaticResource ActionButtonStyle}"
                                  Click="PauseViewButton_Click" />
                    <Button x:Name="LiveButton"
                            Content="Live"
                            Margin="0,0,8,0"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="LiveButton_Click" />
                    <Button x:Name="ClearViewButton"
                            Content="Clear"
                            Margin="0,0,8,0"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="ClearViewButton_Click" />
                    <Button x:Name="ExportCsvButton"
                            Content="Export CSV"
                            Margin="0,0,8,0"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="ExportCsvButton_Click" />
                    <ToggleButton x:Name="AutoScrollButton"
                                  Content="Auto Scroll"
                                  Style="{StaticResource ActionButtonStyle}"
                                  IsChecked="True"
                                  Click="AutoScrollButton_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Row Limit" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox x:Name="RowLimitComboBox"
                              Width="70"
                              SelectionChanged="RowLimitComboBox_SelectionChanged">
                        <ComboBoxItem Content="50" IsSelected="True" />
                        <ComboBoxItem Content="100" />
                        <ComboBoxItem Content="200" />
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="72" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="False">
                    <TextBlock Text="Activity Timeline" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="Link A / Link B lanes &#8226; TX spike up &#8226; RX spike down &#8226; drag to scrub"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <Canvas x:Name="TimelineCanvas"
                        Grid.Row="1"
                        Margin="0,10,0,12"
                        Background="{StaticResource NucInnerBrush}"
                        MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                        MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp"
                        MouseMove="TimelineCanvas_MouseMove"
                        MouseLeave="TimelineCanvas_MouseLeave" />

                <Slider x:Name="TimelineViewportSlider"
                        Grid.Row="2"
                        Margin="56,0,8,12"
                        Minimum="0"
                        Visibility="Collapsed"
                        ValueChanged="TimelineViewportSlider_ValueChanged" />

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="8">
                        <DataGrid x:Name="LinkAGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  RowHeaderWidth="0"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="120" />
                                <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="55" />
                                <DataGridTextColumn Header="Frame" Binding="{Binding FrameType}" Width="80" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="240" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="8">
                        <DataGrid x:Name="LinkBGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  RowHeaderWidth="0"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="120" />
                                <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="55" />
                                <DataGridTextColumn Header="Frame" Binding="{Binding FrameType}" Width="80" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="240" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

