<Window x:Class="IEC101MasterTester.Views.NucLinkTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IEC101MasterTester.Controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="NUC Link Trace"
        Width="1400"
        Height="820"
        MinWidth="1120"
        MinHeight="680"
        Background="#09111D"
        Foreground="#F3F6FB"
        WindowStartupLocation="CenterOwner"
        SizeChanged="NucLinkTraceWindow_SizeChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#F3F6FB" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8EA3BC" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#6B829D" />
            <SolidColorBrush x:Key="PanelBrush" Color="#101B2A" />
            <SolidColorBrush x:Key="PanelAltBrush" Color="#0D1623" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#243449" />
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
            <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="MetricCaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="11" />
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
            <Style x:Key="ActionButtonStyle" TargetType="{x:Type ButtonBase}">
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="Background" Value="#15263A" />
                <Setter Property="BorderBrush" Value="#2C4560" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="MinWidth" Value="82" />
                <Setter Property="Height" Value="34" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Background" Value="#122131" />
                <Setter Property="BorderBrush" Value="#29445D" />
            </Style>
            <Style x:Key="AnalyzerComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="Background" Value="#132133" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Height" Value="36" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="Background" Value="#132133" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <SolidColorBrush x:Key="StatusAccentBrush" Color="#7DB7FF" />
            <Style x:Key="AnalyzerDataGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="HorizontalGridLinesBrush" Value="#1B2A3B" />
                <Setter Property="VerticalGridLinesBrush" Value="#1B2A3B" />
                <Setter Property="RowBackground" Value="#0F1825" />
                <Setter Property="AlternatingRowBackground" Value="#101B29" />
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
        <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardBorderStyle}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NUC Link Trace" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="#0E1A28" BorderBrush="#223449" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Live 60 s tape" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                    </Border>
                    <TextBlock Text="Click burst area to inspect linked traffic." Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                </StackPanel>
                <Border Grid.Column="1" Background="#0E1A28" BorderBrush="#223449" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Read Position" Style="{StaticResource MetricCaptionStyle}" />
                        <TextBlock x:Name="SelectedTimeTextBlock" Text="--:--:--.---" Margin="10,0,0,0" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}" Padding="10,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ToggleButton x:Name="PauseViewButton" Margin="0,0,8,0" Style="{StaticResource ToolbarButtonStyle}" Click="PauseViewButton_Click">
                        <StackPanel>
                            <TextBlock Text="Pause" HorizontalAlignment="Center" />
                            <TextBlock Text="Freeze inspect" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="LiveButton" Margin="0,0,8,0" Style="{StaticResource ToolbarButtonStyle}" Click="LiveButton_Click">
                        <StackPanel>
                            <TextBlock Text="Live" HorizontalAlignment="Center" />
                            <TextBlock Text="Follow newest" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearViewButton" Margin="0,0,8,0" Style="{StaticResource ToolbarButtonStyle}" Click="ClearViewButton_Click">
                        <StackPanel>
                            <TextBlock Text="Clear" HorizontalAlignment="Center" />
                            <TextBlock Text="Reset tape" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportCsvButton" Margin="0,0,8,0" Style="{StaticResource ToolbarButtonStyle}" Click="ExportCsvButton_Click">
                        <StackPanel>
                            <TextBlock Text="Export" HorizontalAlignment="Center" />
                            <TextBlock Text="CSV snapshot" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="AutoScrollButton" Style="{StaticResource ToolbarButtonStyle}" IsChecked="True" Click="AutoScrollButton_Click">
                        <StackPanel>
                            <TextBlock Text="Live Tape" HorizontalAlignment="Center" />
                            <TextBlock Text="Auto scroll" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="Row Limit" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                        <TextBlock Text="Per link panel" Foreground="{StaticResource MutedTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                    </StackPanel>
                    <ComboBox x:Name="RowLimitComboBox" Width="92" Style="{StaticResource AnalyzerComboBoxStyle}" SelectionChanged="RowLimitComboBox_SelectionChanged">
                        <ComboBoxItem Content="50" IsSelected="True" />
                        <ComboBoxItem Content="100" />
                        <ComboBoxItem Content="200" />
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="92" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Activity Timeline" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Border Background="#112338" BorderBrush="#28445E" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,0"><TextBlock Text="Link A waveform" FontSize="10" Foreground="#8BC6FF" /></Border>
                        <Border Background="#10261B" BorderBrush="#295A3E" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,0"><TextBlock Text="Link B waveform" FontSize="10" Foreground="#7DE5A2" /></Border>
                        <TextBlock Text="Click chart to inspect time" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <Canvas x:Name="TimelineRulerCanvas" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" />
                <controls:NucLinkTraceTapeControl x:Name="TimelineTape" Grid.Row="2" Margin="0,4,0,10" />
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NavigatorStartLabel" Text="--:--:--.---" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="12,0" Text="Fixed 60 s recording tape" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="NavigatorEndLabel" Grid.Column="2" Text="--:--:--.---" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="6">
                        <DataGrid x:Name="LinkAGrid" Style="{StaticResource AnalyzerDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="120" />
                                <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="54" />
                                <DataGridTextColumn Header="Frame" Binding="{Binding FrameType}" Width="78" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="235" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="6">
                        <DataGrid x:Name="LinkBGrid" Style="{StaticResource AnalyzerDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="120" />
                                <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="54" />
                                <DataGridTextColumn Header="Frame" Binding="{Binding FrameType}" Width="78" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="235" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
                <Border Grid.Row="5" Margin="0,10,0,0" Background="#0D1623" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Active" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RedundancyActiveLinkText}" Margin="8,0,0,0" Foreground="{StaticResource StatusAccentBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="Link A" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NucMainCommStateText}" Margin="8,0,0,0" Foreground="{StaticResource AppForegroundBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <TextBlock Text="Link B" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NucBackupCommStateText}" Margin="8,0,0,0" Foreground="{StaticResource AppForegroundBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="6" Orientation="Horizontal">
                            <TextBlock Text="Switch" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LastRedundancySwitchText}" Margin="8,0,0,0" Foreground="{StaticResource AppForegroundBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Continuity" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RedundancyContinuityText}" Margin="8,0,0,0" Foreground="{StaticResource AppForegroundBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
