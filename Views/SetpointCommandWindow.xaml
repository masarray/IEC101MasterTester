<Window x:Class="IEC101MasterTester.Views.SetpointCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setpoint Command"
        Width="900"
        Height="520"
        MinWidth="860"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="SectionHeaderCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#0F172A"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#0F172A">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SectionHeaderCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC"
                                       Text="Setpoint Command" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource DarkPopupTextBlockStyle}"
                                       Text="{Binding SignalName}" />
                            <TextBlock Foreground="#94A3B8"
                                       Text="{Binding SignalInfo}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource DarkPopupTextBlockStyle}"
                                   Text="Command IOA" />
                        <TextBox Grid.Column="1"
                                 Height="32"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource DarkPopupTextBoxStyle}"
                                 Text="{Binding CommandIoa}" />
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource DarkPopupTextBlockStyle}"
                                   Text="POOP (%)" />
                        <TextBox Grid.Column="1"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource DarkPopupTextBoxStyle}"
                                 Text="{Binding SetpointPercentText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Border Grid.Row="6"
                            Background="#0F172A"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Foreground="#CBD5E1"
                                       FontWeight="SemiBold"
                                       Text="Normalized Preview" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#14B8A6"
                                       Text="{Binding NormalizedPreviewText}" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#94A3B8"
                                       Text="UI memakai persen 0-100%. Perintah dikirim sebagai C_SE_NA_1 normalized 0.000-1.000." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="8"
                            Background="#0F172A"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#F8FAFC"
                                           Text="Command Actions" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="#14B8A6"
                                           Text="Direct or Select-Before-Operate" />
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0"
                                        Grid.Column="0"
                                        Height="36"
                                        Style="{StaticResource TactilePrimaryButtonStyle}"
                                        Content="Direct Operate"
                                        Click="SendDirect_Click" />

                                <Button Grid.Row="0"
                                        Grid.Column="2"
                                        Height="36"
                                        Style="{StaticResource TactileSecondaryButtonStyle}"
                                        Content="Select"
                                        Click="Select_Click" />

                                <Button Grid.Row="2"
                                        Grid.Column="2"
                                        Height="36"
                                        Style="{StaticResource TactileSecondaryButtonStyle}"
                                        Content="Operate"
                                        Click="Execute_Click" Margin="0,0,8,0" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SectionHeaderCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC"
                                       Text="Setpoint Feedback" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#94A3B8"
                                       Text="{Binding FeedbackHeaderText}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Value" />
                        <TextBox Grid.Row="0" Grid.Column="1" Height="32" IsReadOnly="True" VerticalContentAlignment="Center" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding FeedbackValueText}" />

                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Percent" />
                        <TextBox Grid.Row="2" Grid.Column="1" Height="32" IsReadOnly="True" VerticalContentAlignment="Center" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding FeedbackPercentText}" />

                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Style="{StaticResource DarkPopupTextBlockStyle}" Text="Timestamp" />
                        <TextBox Grid.Row="4" Grid.Column="1" Height="32" IsReadOnly="True" VerticalContentAlignment="Center" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding FeedbackTimestampText}" />

                        <TextBlock Grid.Row="6" VerticalAlignment="Center" Style="{StaticResource DarkPopupTextBlockStyle}" Text="COT / Class" />
                        <TextBox Grid.Row="6" Grid.Column="1" Height="32" IsReadOnly="True" VerticalContentAlignment="Center" Style="{StaticResource DarkPopupTextBoxStyle}" Text="{Binding FeedbackMetaText}" />
                    </Grid>

                    <Border Grid.Row="4"
                            Background="#0F172A"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC"
                                       Text="Command Response Monitor" />

                            <DataGrid Grid.Row="2"
                                      MaxHeight="220"
                                      ItemsSource="{Binding CommandLifeMonitor}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="False"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      RowHeight="24"
                                      ColumnHeaderHeight="26"
                                      FontSize="10.5"
                                      GridLinesVisibility="Horizontal"
                                      Background="#0F172A"
                                      Foreground="#E5EDF7"
                                      BorderThickness="1"
                                      BorderBrush="#334155"
                                      HorizontalGridLinesBrush="#182434"
                                      VerticalGridLinesBrush="#182434"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.CanContentScroll="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="58" />
                                    <DataGridTextColumn Header="IOA" Binding="{Binding IoaText}" Width="54" />
                                    <DataGridTextColumn Header="Op" Binding="{Binding Operation}" Width="92" />
                                    <DataGridTextColumn Header="Mode" Binding="{Binding ModeShort}" Width="64" />
                                    <DataGridTextColumn Header="Result" Binding="{Binding ResultShort}" Width="56" />
                                    <DataGridTextColumn Header="FB" Binding="{Binding FeedbackText}" Width="74" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
