<Window x:Class="IEC101MasterTester.Views.ConnectionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Connection Setup"
        Width="620"
        Height="644"
        MinWidth="580"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0F172A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Layout / typography -->
            <Style x:Key="SetupLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#E2E8F0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,14,0"/>
            </Style>

            <Style x:Key="SetupTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DarkPopupTextBoxStyle}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="SetupCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DarkPopupCheckBoxStyle}">
                <Setter Property="Margin" Value="0,6,0,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#E2E8F0"/>
            </Style>

            <Style x:Key="SetupFieldContainerStyle" TargetType="Border">
                <Setter Property="Padding" Value="0,2,0,2"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <Style x:Key="SetupRowLabelContainerStyle" TargetType="Border">
                <Setter Property="Padding" Value="0,4,0,4"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- ComboBox item -->
            <Style x:Key="SetupComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#F8FAFC"/>
                <Setter Property="Background" Value="#0F172A"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#132033"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Full clickable ComboBox -->
            <Style x:Key="SetupComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Foreground" Value="#F8FAFC"/>
                <Setter Property="Background" Value="#0F172A"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="10,0,36,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource SetupComboBoxItemStyle}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="OuterBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>

                                        <!-- clickable display area -->
                                        <ContentPresenter x:Name="ContentSite"
                                                          Grid.Column="0"
                                                          Margin="10,0,6,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                                        <!-- right arrow area -->
                                        <Border Grid.Column="1"
                                                Background="#132033"
                                                BorderBrush="#334155"
                                                BorderThickness="1,0,0,0"
                                                CornerRadius="0,4,4,0">
                                            <Path Width="10"
                                                  Height="6"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Fill="#CBD5E1"
                                                  Data="M 0 0 L 10 0 L 5 6 Z"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- invisible full-area toggle overlay -->
                                <ToggleButton x:Name="DropDownToggle"
                                              Grid.ColumnSpan="2"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- editable textbox -->
                                <TextBox x:Name="PART_EditableTextBox"
                                         Visibility="Hidden"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         VerticalContentAlignment="Center"
                                         Margin="10,0,36,0"/>

                                <!-- popup -->
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border Background="#0F172A"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="280"
                                                      SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#22D3EE"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#22D3EE"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#22D3EE"/>
                                </Trigger>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="Popup" Property="MinHeight" Value="60"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="OuterBorder" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="14" Background="#0F172A" LastChildFill="True">

        <!-- Bottom action bar -->
        <Border DockPanel.Dock="Bottom"
                Margin="0,14,0,0"
                Padding="0,12,0,0"
                BorderBrush="#334155"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#FCA5A5"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"
                           Text="{Binding ValidationMessage}" />

                <Button Grid.Column="1"
                        Width="92"
                        Height="32"
                        Margin="0,0,8,0"
                        Style="{StaticResource TactilePrimaryButtonStyle}"
                        Content="Save"
                        IsDefault="True"
                        Click="Save_Click" />

                <Button Grid.Column="2"
                        Width="92"
                        Height="32"
                        Style="{StaticResource TactileSecondaryButtonStyle}"
                        Content="Cancel"
                        IsCancel="True" />
            </Grid>
        </Border>

        <!-- Main content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True"
                      Background="#0F172A">
            <Grid Margin="0,0,4,0"
                  Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" SharedSizeGroup="LabelCol" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0 -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Serial Port"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SetupFieldContainerStyle}">
                    <ComboBox Style="{StaticResource SetupComboBoxStyle}"
                              ItemsSource="{Binding SerialPortOptions}"
                              SelectedItem="{Binding SerialPort}"
                              HorizontalAlignment="Stretch"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <Button Width="86"
                            Height="32"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TactileSecondaryButtonStyle}"
                            Content="Refresh"
                            Click="RefreshPorts_Click"/>
                </Border>

                <!-- Row 1 -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Baud Rate"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <ComboBox Style="{StaticResource SetupComboBoxStyle}"
                              ItemsSource="{Binding BaudRateOptions}"
                              SelectedItem="{Binding BaudRate}"/>
                </Border>

                <!-- Row 2 -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Data Bits"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <ComboBox Style="{StaticResource SetupComboBoxStyle}"
                              ItemsSource="{Binding DataBitOptions}"
                              SelectedItem="{Binding DataBits}"/>
                </Border>

                <!-- Row 3 -->
                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Parity"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <ComboBox Style="{StaticResource SetupComboBoxStyle}"
                              ItemsSource="{Binding ParityOptions}"
                              SelectedItem="{Binding Parity}"/>
                </Border>

                <!-- Row 4 -->
                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Stop Bits"/>
                </Border>
                <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <ComboBox Style="{StaticResource SetupComboBoxStyle}"
                              ItemsSource="{Binding StopBitOptions}"
                              SelectedItem="{Binding StopBits}"/>
                </Border>

                <!-- Row 5 -->
                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Link Layer Mode"/>
                </Border>
                <Border Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <ComboBox Style="{StaticResource SetupComboBoxStyle}"
                              ItemsSource="{Binding LinkLayerModeOptions}"
                              SelectedItem="{Binding LinkLayerMode}"/>
                </Border>

                <!-- Row 6 -->
                <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Link Address Length"/>
                </Border>
                <Border Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <ComboBox Style="{StaticResource SetupComboBoxStyle}"
                              ItemsSource="{Binding LinkAddressLengthOptions}"
                              SelectedItem="{Binding LinkAddressLength}"/>
                </Border>

                <!-- Row 7 -->
                <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Link Address"/>
                </Border>
                <Border Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <TextBox Style="{StaticResource SetupTextBoxStyle}"
                             Text="{Binding LinkAddress}"/>
                </Border>

                <!-- Row 8 -->
                <Border Grid.Row="8" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="CASDU Length"/>
                </Border>
                <Border Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <ComboBox Style="{StaticResource SetupComboBoxStyle}"
                              ItemsSource="{Binding CasduLengthOptions}"
                              SelectedItem="{Binding CasduLength}"/>
                </Border>

                <!-- Row 9 -->
                <Border Grid.Row="9" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="CASDU / ASDU Address"/>
                </Border>
                <Border Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <TextBox Style="{StaticResource SetupTextBoxStyle}"
                             Text="{Binding CasduAddress}"/>
                </Border>

                <!-- Row 10 -->
                <Border Grid.Row="10" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="IOA Length"/>
                </Border>
                <Border Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <ComboBox Style="{StaticResource SetupComboBoxStyle}"
                              ItemsSource="{Binding IoaLengthOptions}"
                              SelectedItem="{Binding IoaLength}"/>
                </Border>

                <!-- Row 11 -->
                <Border Grid.Row="11" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Originator Address"/>
                </Border>
                <Border Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <TextBox Style="{StaticResource SetupTextBoxStyle}"
                             Text="{Binding OriginatorAddress}"/>
                </Border>

                <!-- Row 12 -->
                <Border Grid.Row="12" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Response Timeout (ms)"/>
                </Border>
                <Border Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <TextBox Style="{StaticResource SetupTextBoxStyle}"
                             Text="{Binding ResponseTimeoutMs}"/>
                </Border>

                <!-- Row 13 -->
                <Border Grid.Row="13" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Link Status Timeout (ms)"/>
                </Border>
                <Border Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <TextBox Style="{StaticResource SetupTextBoxStyle}"
                             Text="{Binding LinkStatusTimeoutMs}"/>
                </Border>

                <!-- Row 14 -->
                <Border Grid.Row="14" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Class 2 Poll Interval (ms)"/>
                </Border>
                <Border Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <TextBox Style="{StaticResource SetupTextBoxStyle}"
                             Text="{Binding PollIntervalMs}"/>
                </Border>

                <!-- Row 15 -->
                <Border Grid.Row="15" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Run Loop Delay (ms)"/>
                </Border>
                <Border Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <TextBox Style="{StaticResource SetupTextBoxStyle}"
                             Text="{Binding RunLoopDelayMs}"/>
                </Border>

                <!-- Row 16 -->
                <Border Grid.Row="16" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Class 1 Poll Interval (ms)"/>
                </Border>
                <Border Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <TextBox Style="{StaticResource SetupTextBoxStyle}"
                             Text="{Binding Class1PollIntervalMs}"/>
                </Border>

                <!-- Row 17 -->
                <Border Grid.Row="17" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="Busy Backoff (ms)"/>
                </Border>
                <Border Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <TextBox Style="{StaticResource SetupTextBoxStyle}"
                             Text="{Binding BusyBackoffMs}"/>
                </Border>

                <!-- Row 18 -->
                <Border Grid.Row="18" Grid.Column="0" Style="{StaticResource SetupRowLabelContainerStyle}">
                    <TextBlock Style="{StaticResource SetupLabelStyle}" Text="GI Startup Delay (ms)"/>
                </Border>
                <Border Grid.Row="18" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SetupFieldContainerStyle}">
                    <TextBox Style="{StaticResource SetupTextBoxStyle}"
                             Text="{Binding GiStartupDelayMs}"/>
                </Border>

                <!-- Row 19 -->
                <StackPanel Grid.Row="19"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,12,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" SharedSizeGroup="LabelCol" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource SetupLabelStyle}"
                                   Text="Master Engine"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource SetupComboBoxStyle}"
                                  ItemsSource="{Binding MasterEngineOptions}"
                                  SelectedItem="{Binding MasterEngine}"/>
                    </Grid>

                    <CheckBox Style="{StaticResource SetupCheckBoxStyle}"
                              IsChecked="{Binding UseGeneralInterrogationOnConnect}"
                              Content="   Use General Interrogation on Connect"/>
                    <CheckBox Style="{StaticResource SetupCheckBoxStyle}"
                              IsChecked="{Binding UseClockSyncOnConnect}"
                              Content="   Use Clock Sync on Connect"/>
                    <CheckBox Style="{StaticResource SetupCheckBoxStyle}"
                              IsChecked="{Binding UseSingleCharAck}"
                              Content="   Use Single Character ACK"/>
                </StackPanel>

                <!-- Row 20 -->
                <TextBlock Grid.Row="20"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,16,0,0"
                           Foreground="#94A3B8"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Text="Default timing now follows IEC-Test style baseline: 100 ms poll, 100 ms run loop, 100 ms class 1 interval. Tuning is user-controlled and persisted in this dialog." />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
