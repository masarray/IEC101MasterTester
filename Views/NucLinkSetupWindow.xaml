<Window x:Class="IEC101MasterTester.Views.NucLinkSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArSul IEC-60870-5-101 Link Setup"
        Width="520"
        Height="420"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUi/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16" LastChildFill="True">
        <Border DockPanel.Dock="Bottom"
                Margin="0,14,0,0"
                Padding="0,12,0,0"
                BorderBrush="#334155"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="#FCA5A5"
                           TextWrapping="Wrap"
                           Text="{Binding ValidationMessage}" />
                <Button Grid.Column="1"
                        Width="96"
                        Height="32"
                        Margin="0,0,8,0"
                        Style="{StaticResource TactilePrimaryButtonStyle}"
                        Click="Save_Click"
                        Content="Save" />
                <Button Grid.Column="2"
                        Width="96"
                        Height="32"
                        Style="{StaticResource TactileSecondaryButtonStyle}"
                        IsCancel="True"
                        Content="Cancel" />
            </Grid>
        </Border>

        <StackPanel>
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#F8FAFC"
                       Text="ArSul IEC-101 Dual Link Setup" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#94A3B8"
                       TextWrapping="Wrap"
                       Text="Configure Link A and Link B once, then use the NUC window for observation and switchover analysis." />

            <TextBlock Margin="0,18,0,4" Foreground="#CBD5E1" Text="Link A / Main COM Port" />
            <ComboBox ItemsSource="{Binding SerialPortOptions}" SelectedItem="{Binding PrimaryPort, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,14,0,4" Foreground="#CBD5E1" Text="Link B / Backup COM Port" />
            <ComboBox ItemsSource="{Binding SerialPortOptions}" SelectedItem="{Binding BackupPort, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,14,0,4" Foreground="#CBD5E1" Text="Redundancy Mode" />
            <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,14,0,4" Foreground="#CBD5E1" Text="GI Policy" />
            <ComboBox ItemsSource="{Binding GiPolicyOptions}" SelectedItem="{Binding SelectedGiPolicy, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </DockPanel>
</Window>
